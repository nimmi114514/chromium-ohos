+/**
+ * GPU native IPC operation codes,
+ * used for indexing in a function array,
+ * must be declared consecutively.
+ */
+enum class GpuNativeIpcOpCode : uint32_t {
+  INVALID_OPERATION_CODE,
+  /** Start operation code. */
