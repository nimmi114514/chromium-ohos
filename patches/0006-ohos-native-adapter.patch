+  INITIALIZE_WINDOW_ADAPTER,
+  ADD_WINDOW,
+  REMOVE_WINDOW,
+  SET_WINDOW_WIDGET,
+  NOTIFY_WINDOW_CHANGE,
+  /** Maximum operation code. */
