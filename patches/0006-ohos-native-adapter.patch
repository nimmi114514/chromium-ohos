+NativeChildProcessLibrary::CreateChildProcessConfigs() {
+  if (!create_child_process_configs_func_) {
+    LOGE("OH_Ability_CreateChildProcessConfigs not loaded.");
+    return nullptr;
+  }
+  return create_child_process_configs_func_();
+}
