+class Value {
+public:
+    virtual ~Value() = default;
+
+    operator bool() { return GetBool(); }
+
+    operator uint8_t() { return GetUint8(); }
+
+    operator int8_t() { return GetInt8(); }
+
+    operator uint16_t() { return GetUint16(); }
+
