diff --git a/third_party/aki/include/aki/definer/class_definer.h b/third_party/aki/include/aki/definer/class_definer.h
new file mode 100644
index 0000000000..50427b62c3
--- /dev/null
+++ b/third_party/aki/include/aki/definer/class_definer.h
@@ -0,0 +1,157 @@
+/*
