+template<typename T>
+Value::Value(T&& value)
+{
+    napi_env env = aki::Binding::GetScopedEnv();
+    napi_value handle = NapiValue<T>::ToNapiValue(env, std::forward<T>(value));
+
+    internal::Value* ival = new NapiValueMaker<napi_value>(env, handle);
+    handle_.reset(ival);
+    persistent_ = Persistent(handle);
+}
