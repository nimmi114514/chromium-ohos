diff --git a/third_party/aki/include/aki/class/class_wrapper.h b/third_party/aki/include/aki/class/class_wrapper.h
new file mode 100644
index 0000000000..1286049905
--- /dev/null
+++ b/third_party/aki/include/aki/class/class_wrapper.h
@@ -0,0 +1,157 @@
+/*
