+#include "gtest/gtest.h"
+
+namespace ohos::adapter {
+template <typename T>
+class SingletonHolder {
+ public:
+  static T* GetInstance() {
+    CheckInstance();
+    return instance;
+  }
+
+  static void SetInstance(T* impl) {
+    instance = impl;
+  }
+
+  static void ClearInstance() {
+    instance = nullptr;
+  }
+
+  private:
+  static void CheckInstance() {
+    ASSERT_TRUE(instance != nullptr) << "instance not set yet.";
+  }
+
+  inline static T* instance = nullptr;
+};
+} // namespace ohos::adapter
+
+#endif
