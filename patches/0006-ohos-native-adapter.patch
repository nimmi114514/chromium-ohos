+void XComponentImpl::OnSurfaceChanged() {
+  TRACE_EVENT_0("OnSurfaceChanged");
+}
+
+void XComponentImpl::OnSurfaceDestroyed() {
+  TRACE_EVENT_0("OnSurfaceDestroyed");
+  delegate_->OnWidgetDestroyed(GetId());
+}
