+void OH_IPCRemoteProxy_Destroy(OHIPCRemoteProxy* remote_proxy) {
+  NativeApi* api = NativeApiMockManager::GetInstance().GetApiImpl();
+  EXPECT_NE(nullptr, api);
+  api->IpcRemoteProxyDestroy(remote_proxy);
+}
