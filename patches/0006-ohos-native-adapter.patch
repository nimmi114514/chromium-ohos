+  ET_SURFACE_CHANGE = 0,
+  ET_SURFACE_FOCUS = 1,
+  ET_SURFACE_BLUR = 2,
+  ET_WINDOW_SIZE_CHANGE = 3,
+  ET_WINDOW_CHANGE = 4,
+  ET_WINDOW_RECT_CHANGE = 5,
+  ET_WINDOW_STATUS_CHANGE = 6,
+  ET_WINDOW_CAPTION_BUTTON_RECT_CHANGE = 7,
+  ET_DEVICE_MODE_CHANGED = 8,
+  ET_WINDOW_DISPLAY_ID_CHANGE = 9,
+  ET_BACK_TO_LAST_PAGE = 10
+};
