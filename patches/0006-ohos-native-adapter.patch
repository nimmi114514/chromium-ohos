+        typedef std::unordered_map<K, T> M;
+        return *(reinterpret_cast<M*>(GetDataReference()));
+    }
+
+    template<typename K, typename T>
+    std::unordered_set<K, T>& HashSetReference ()
+    {
+        typedef std::unordered_set<K, T> M;
+        return *(reinterpret_cast<M*>(GetDataReference()));
+    }
+    
+    template<typename T>
+    std::vector<T>& VectorReference ()
+    {
+        typedef std::vector<T> V;
+        return *(reinterpret_cast<V*>(GetDataReference()));
+    }
+    
+    template<typename T, std::size_t N>
+    std::array<T, N>& ArrayReference ()
+    {
+        typedef std::array<T, N> A;
+        return *(reinterpret_cast<A*>(GetDataReference()));
+    }
+
+#ifndef USING_CXX_STANDARD_11
+
+    template<typename T>
+    std::optional<T>& OptionalReference ()
+    {
+        typedef std::optional<T> O;
+        return *(reinterpret_cast<O*>(GetDataReference()));
+    }
+
+#endif
+
+    virtual bool IsUndefined() const { return false; }
+
+    virtual bool IsNull() const { return false; }
+
+    virtual bool IsBool() const { return false; }
+
+    virtual bool IsNumber() const { return false; }
+
+    virtual bool IsString() const { return false; }
+
+    virtual bool IsObject() const { return false; }
+
+    virtual bool IsArray() const { return false; }
+
+    virtual bool IsFunction() const { return false; }
