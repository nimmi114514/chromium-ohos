+template<typename T>
+std::optional<T> NapiValue<std::optional<T>>::GetOptional()
+{
+    napi_status status;
+    napi_valuetype type;
+    status = napi_typeof(env_, value_, &type);
+    AKI_DCHECK(status == napi_ok);
+    if (type == napi_undefined) {
+        return {};
