diff --git a/third_party/aki/include/aki/binder/binder.h b/third_party/aki/include/aki/binder/binder.h
new file mode 100644
index 0000000000..e387e00a58
--- /dev/null
+++ b/third_party/aki/include/aki/binder/binder.h
@@ -0,0 +1,148 @@
+/*
