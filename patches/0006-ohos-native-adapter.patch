+
+    auto napiValue = NapiValue<typename ValueDefiner<T>::RawType>(env_, value_);
+    T t = NapiValueTrait<typename ValueDefiner<T>::RawType>::Cast(napiValue);
+
+    return std::optional<T>(t);
