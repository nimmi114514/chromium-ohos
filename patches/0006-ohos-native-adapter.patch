+  int url_err_code = UDMF_E_INVALID_PARAM;
+  if (!drag_param->basic_data.url.empty()) {
+    url_err_code = OH_UdsHyperlink_SetUrl(hyperlink_ptr.get(),
+                                          drag_param->basic_data.url.c_str());
+    if (url_err_code != UDMF_E_OK) {
