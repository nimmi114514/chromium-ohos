+  WindowRect content_bounds_;
+  WindowRect initial_bounds_;
+  int64_t initial_display_id_ = -1;
+  int64_t current_display_id_ = -1;
+  WindowStatusType initial_state_;
+  WindowLimits system_window_limits_;  // in vp
