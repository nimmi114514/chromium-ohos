 namespace views {
 
+namespace {
+
+// How long the window background color is kept on the XComponent after the
+// first frame has been committed. The first commit can still be an empty
+// window, so this gives the content a chance to reach the surface; afterwards
+// the color is not visible any more because Chromium covers the whole surface.
+constexpr base::TimeDelta kSurfaceFinalizeDelay = base::Milliseconds(150);
+
+// RenderService only keeps hardware composition (HWC) enabled for an XComponent
+// whose background is fully opaque black.
+constexpr uint32_t kSurfaceOpaqueBlack = 0xFF000000;
