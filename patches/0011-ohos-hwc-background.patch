+
+void DesktopWindowTreeHostOhos::OnWidgetInitDone() {
+  DesktopWindowTreeHostPlatform::OnWidgetInitDone();
+  ObserveCompositor();
+}
+
+void DesktopWindowTreeHostOhos::ObserveCompositor() {
+  if (observed_compositor_) {
+    return;
+  }
+  ui::Compositor* compositor = this->compositor();
+  if (!compositor) {
+    LOG(WARNING) << "[ohoswindow] window " << GetWindowId()
+                 << " has no compositor yet, hardware composition stays off";
+    return;
+  }
+  observed_compositor_ = compositor;
+  compositor->AddObserver(this);
+}
+
+void DesktopWindowTreeHostOhos::OnCompositingDidCommit(
+    ui::Compositor* compositor) {
+  if (surface_finalized_ || surface_finalize_timer_.IsRunning()) {
+    return;
+  }
+  // Chromium content covers the XComponent from this commit on, so the window
+  // background color is no longer needed.
+  if (observed_compositor_) {
+    observed_compositor_->RemoveObserver(this);
+    observed_compositor_ = nullptr;
+  }
+  surface_finalize_timer_.Start(
+      FROM_HERE, kSurfaceFinalizeDelay, this,
+      &DesktopWindowTreeHostOhos::ApplyFinalSurfaceState);
+}
+
+void DesktopWindowTreeHostOhos::ApplyFinalSurfaceState() {
+  if (surface_finalized_) {
+    return;
+  }
+  surface_finalized_ = true;
+  surface_finalize_timer_.Stop();
+  const std::string window_id = GetWindowId();
+  if (window_id.empty()) {
+    LOG(WARNING) << "[ohoswindow] no window id, cannot enable hardware "
+                    "composition for this surface";
+    return;
+  }
+  ohos::adapter::taskRunner::MainThreadTaskRunner::GetInstance().PostTask(
+      [window_id]() {
+        ohos::adapter::xcomponent::XComponentManager::GetInstance()
+            ->SetNodeHandleXComponentBackgroundColor(window_id,
+                                                     kSurfaceOpaqueBlack);
+      });
+}
+
+std::string DesktopWindowTreeHostOhos::GetWindowId() const {
+  const ui::PlatformWindow* window = platform_window();
+  return window ? window->GetWindowUniqueId() : std::string();
 }
 
