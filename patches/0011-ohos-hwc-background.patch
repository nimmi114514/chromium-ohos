+// RSUniHwcVisitor::ProcessSolidLayerDisabled(): a transparent background and an
+// opaque non black background are both rejected.
+//
+// The background is visible until the first Chromium frame covers the surface,
+// so a window starts with the window background color of the current theme
+// (opaque white for the light theme, the dark theme color for the dark theme,
+// both taken from the ColorProvider) and switches to this color once content
+// has been drawn.
+//
+// Surface backgrounds must be opaque, a translucent value makes the system
+// treat the XComponent as transparent and disables hardware composition for it.
+uint32_t OpaqueWindowColor(uint32_t argb) {
+  return argb | 0xFF000000;
+}
