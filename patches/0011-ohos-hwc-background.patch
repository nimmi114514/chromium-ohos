+// Applies |argb| as the ArkUI background color of |node_handle|. Must run on
+// the ArkUI main thread.
+bool SetNodeHandleBackgroundColor(ArkUI_NodeHandle node_handle,
+                                  const std::string& xcomponent_id,
+                                  uint32_t argb) {
+  ArkUI_NativeNodeAPI_1* node_api = GetNativeNodeAPI();
+  if (node_handle == nullptr || node_api == nullptr) {
+    LOGE("[XComponentManager] %{public}s has no node, skip background",
+         xcomponent_id.c_str());
+    return false;
+  }
+  ArkUI_NumberValue color_value[] = {{.u32 = argb}};
+  ArkUI_AttributeItem color_item = {color_value, 1};
+  auto result =
+      node_api->setAttribute(node_handle, NODE_BACKGROUND_COLOR, &color_item);
+  if (result != ARKUI_ERROR_CODE_NO_ERROR) {
+    LOGE("[XComponentManager] %{public}s set BACKGROUND_COLOR failed, "
+         "res %{public}d",
+         xcomponent_id.c_str(), result);
+    return false;
+  }
+  return true;
+}
