+
+void OhosWindow::RegistWindowEvent() {
+  auto dispatch = base::BindPostTask(
+      ui_task_runner_,
+      base::BindRepeating(
+          [](base::WeakPtr<OhosWindow> window, gfx::AcceleratedWidget widget,
+             std::shared_ptr<XCEvent> event) {
+            if (!window) {
+              return;
+            }
+            CHECK(event);
+            if (widget != window->GetWidget()) {
+              LOG(ERROR) << "handle event error no matched widget: " << widget;
+              return;
+            }
+            window->HandleEvent(event);
+          },
+          AsWeakPtr()));
+  WindowAdapter::GetInstance().RegistWindowEvent(
+      GetWidget(), [dispatch](gfx::AcceleratedWidget widget,
+                              std::shared_ptr<XCEvent> event) {
+        dispatch.Run(widget, std::move(event));
+      });
+}
+
+void OhosWindow::UnRegistWindowEvent() {
+  WindowAdapter::GetInstance().UnregistWindowEvent(GetWidget());
+}
+
+void OhosWindow::OnSurfaceCreated() {
+  LOG(INFO) << "[ohoswindow] in OhosWindow OnSurfaceCreated.";
+  auto task = base::BindOnce([](base::WeakPtr<OhosWindow> window,
+                                gfx::AcceleratedWidget widget) {
+        if (!window) {
+          LOG(WARNING) << "[ohoswindow] window is nullptr.";
+          return;
+        }
+        if (window->widget_available_notified_) {
+          return;
+        }
+        window->widget_available_notified_ = true;
+        window->delegate()->OnAcceleratedWidgetAvailable(widget);
+      },
+      AsWeakPtr(), GetWidget());
+  ui_task_runner_->PostTask(FROM_HERE, std::move(task));
+}
+
+void OhosWindow::OnSurfaceDestoryed() {
+  LOG(INFO) << "[ohoswindow] in OhosWindow OnSurfaceDestoryed.";
+  auto task = base::BindOnce([](base::WeakPtr<OhosWindow> window) {
+        if (window) {
+          LOG(INFO) << "[ohoswindow] OhosWindow on surface destroyed call window on close request";
+          window->delegate()->OnCloseRequest();
+        }
+      },
+      AsWeakPtr());
+  ui_task_runner_->PostTask(FROM_HERE, std::move(task));
+}
