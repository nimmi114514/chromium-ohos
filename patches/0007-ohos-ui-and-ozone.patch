+#ifndef UI_OZONE_PLATFORM_OHOS_HOST_OHOS_TOPLEVEL_WINDOW_H_
+#define UI_OZONE_PLATFORM_OHOS_HOST_OHOS_TOPLEVEL_WINDOW_H_
+
+#include <optional>
+
+#include "base/memory/raw_ptr.h"
+#include "ui/display/display.h"
