+void InputMethodOHOS::SetVirtualKeyboardVisibilityIfEnabled(bool should_show) {
+  ui::RequestKeyboardReason reason =
+      ui::RequestKeyboardReason::REQUEST_KEYBOARD_REASON_NONE;
