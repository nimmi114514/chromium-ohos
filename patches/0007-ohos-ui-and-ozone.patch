+#include "ui/aura/window_tree_host.h"
+
+namespace views {
+
+display::Display GetDisplayForWidget(const gfx::AcceleratedWidget widget_id) {
+  display::Display display;
+  auto* host = aura::WindowTreeHost::GetForAcceleratedWidget(widget_id);
+  if (host == nullptr || host->window() == nullptr) {
+    return display;
+  }
+  display::Screen* screen = display::Screen::Get();
+  display = screen->GetDisplayNearestWindow(host->window());
+  return display;
+}
+}  // namespace views
