+display::Display OhosScreen::GetDisplayNearestPoint(
+    const gfx::Point& point) const {
+  auto displays = GetAllDisplays();
+  if (displays.size() <= 1) {
+    return GetPrimaryDisplay();
+  }
+  return *display::FindDisplayNearestPoint(displays, point);
+}
