+  LOG(INFO) << kPasteboardLogTag
+            << __FUNCTION__
+            << ", markup_len:" << markup.length()
+            << ", url_len:" << (source_url ? source_url->length() : 0);
+  ClipboardDataBuilderOhos::WriteHTML(markup, source_url);
+}
