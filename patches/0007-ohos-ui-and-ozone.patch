+      const gfx::AcceleratedWidget widget_id,
+      NodeHandleMouseEventData& mouse_event_data,
+      const EventFlags key_flags);
+  void SendWindowTouchEventForTabDragNodeHandle(
+      const gfx::AcceleratedWidget widget_id,
+      NodeHandleTouchEventData& touch_event_data);
+
+ private:
