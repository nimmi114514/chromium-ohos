+void ClipboardOHOS::WriteSvg(std::string_view markup) {
+  WriteData(ClipboardFormatType::SvgType(), base::as_bytes(base::span(markup)));
+}
+
+void ClipboardOHOS::WriteRTF(std::string_view rtf) {
