+
+std::string AXTreeFormatterOhos::ProcessTreeForOutput(const base::DictValue& node) const {
+  return "";
+}
+
+base::DictValue AXTreeFormatterOhos::BuildTree(AXPlatformNodeDelegate* root) const {
+  return base::DictValue();
+}
+
+}  // namespace ui
