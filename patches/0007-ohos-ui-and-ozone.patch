+  auto dispatch = base::BindPostTask(
+      base::TaskRunnerOHOS::GetUIThreadTaskRunner(),
+      base::BindRepeating(&OhosScreen::OnAvailableAreaCallback,
+                          weak_ptr_factory_.GetWeakPtr()));
+  screen_adapter.RegisterAvailableAreaCallback(
+      [dispatch](ohos::adapter::window::WindowRect work_area, int32_t display_id) {
+        dispatch.Run(work_area, display_id);
+      });
+}
