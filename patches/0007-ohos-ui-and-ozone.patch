+void GetTextConfigFunc(InputMethod_TextEditorProxy* text_editor_proxy,
+                       InputMethod_TextConfig* config) {
+  if (!text_editor_proxy || !config) {
+    LOG(ERROR) << "[InputMethodOHOSCAPI] " << __FUNCTION__
+               << (!text_editor_proxy ? " text_editor_proxy nullptr error"
+                                      : " config nullptr error");
+    return;
+  }
+
+  // The SDK requires a synchronous response on its callback thread. Read a
+  // snapshot made on UI, without dereferencing the UI-owned input method or
+  // posting the SDK-owned output pointer beyond this callback's lifetime.
+  auto snapshot = InputRelationSingleton::GetInstance().GetTextConfigSnapshot(
+      text_editor_proxy);
+  if (!snapshot) {
+    return;
+  }
+  OH_TextConfig_SetInputType(config, InputTypeChromiumToOH(snapshot->first));
+  OH_TextConfig_SetEnterKeyType(config, IME_ENTER_KEY_DONE);
+  InputMethod_CursorInfo* cursor = nullptr;
+  if (OH_TextConfig_GetCursorInfo(config, &cursor) == IME_ERR_OK && cursor) {
+    const auto& rect = snapshot->second;
+    OH_CursorInfo_SetRect(cursor, rect.x(), rect.y(), rect.width(), rect.height());
+  }
+}
