+namespace gl {
+
+gl::NativeViewGLSurfaceEGLOhos::NativeViewGLSurfaceEGLOhos(
+    GLDisplayEGL* display,
+    EGLNativeWindowType window,
+    std::unique_ptr<gfx::VSyncProvider> vsync_provider)
+    : NativeViewGLSurfaceEGL(display, window, std::move(vsync_provider)) {}
+
+gfx::Size NativeViewGLSurfaceEGLOhos::GetSize() {
+  return size_;
+}
+
+EGLConfig NativeViewGLSurfaceEGLOhos::GetConfig() {
+  if (!hdr_output_) {
+    return NativeViewGLSurfaceEGL::GetConfig();
+  }
+  if (!config_) {
+    const EGLint attributes[] = {
+        EGL_SURFACE_TYPE, EGL_WINDOW_BIT, EGL_RENDERABLE_TYPE, EGL_OPENGL_ES2_BIT,
+        EGL_RED_SIZE, 10, EGL_GREEN_SIZE, 10, EGL_BLUE_SIZE, 10, EGL_ALPHA_SIZE, 2,
+        EGL_NONE};
+    EGLint count = 0;
+    if (!eglChooseConfig(GetEGLDisplay(), attributes, &config_, 1, &count) ||
+        count == 0) {
+      config_ = nullptr;
+    }
+  }
+  return config_;
+}
+
+EGLint NativeViewGLSurfaceEGLOhos::GetEGLColorSpace() const {
+  return hdr_output_ ? EGL_GL_COLORSPACE_BT2020_PQ_EXT
+                     : p3_output_ ? EGL_GL_COLORSPACE_DISPLAY_P3_PASSTHROUGH_EXT
+                                  : NativeViewGLSurfaceEGL::GetEGLColorSpace();
+}
+
+bool NativeViewGLSurfaceEGLOhos::InitializeNativeWindow() {
+  if (!hdr_output_ && !native_format_changed_) {
+    return true;
+  }
+  auto* window = reinterpret_cast<OHNativeWindow*>(window_);
+  const int format = hdr_output_ ? NATIVEBUFFER_PIXEL_FMT_RGBA_1010102
+                                 : NATIVEBUFFER_PIXEL_FMT_RGBA_8888;
+  return OH_NativeWindow_NativeWindowHandleOpt(window, SET_FORMAT, format) == 0;
+}
+
+bool NativeViewGLSurfaceEGLOhos::Resize(const gfx::Size& size,
+                                        float scale_factor,
+                                        const gfx::ColorSpace& color_space,
+                                        bool has_alpha) {
+  const bool hdr = color_space.IsHDR();
+  const bool p3 = !hdr && color_space.GetPrimaryID() == gfx::ColorSpace::PrimaryID::P3;
+  const bool color_changed = hdr != hdr_output_ || p3 != p3_output_;
+  if (size == size_ && !color_changed)
+    return true;
+
+  size_ = size;
+
+  if (color_changed) {
+    hdr_output_ = hdr;
+    p3_output_ = p3;
+    native_format_changed_ = true;
+    config_ = nullptr;
+    if (!Recreate()) {
+      return false;
+    }
+    auto* window = reinterpret_cast<OHNativeWindow*>(window_);
+    const auto native_color_space = hdr ? OH_COLORSPACE_BT2020_PQ_FULL
+                                  : p3 ? OH_COLORSPACE_P3_FULL
+                                       : OH_COLORSPACE_SRGB_FULL;
+    const int color_result = OH_NativeWindow_SetColorSpace(window, native_color_space);
+    OH_NativeBuffer_MetadataType type = hdr ? OH_VIDEO_HDR_HDR10 : OH_VIDEO_NONE;
+    const int metadata_result = OH_NativeWindow_SetMetadataValue(
+        window, OH_HDR_METADATA_TYPE, sizeof(type),
+        reinterpret_cast<uint8_t*>(&type));
+    EGLint red = 0, alpha = 0;
+    eglGetConfigAttrib(GetEGLDisplay(), GetConfig(), EGL_RED_SIZE, &red);
+    eglGetConfigAttrib(GetEGLDisplay(), GetConfig(), EGL_ALPHA_SIZE, &alpha);
+    LOG(INFO) << "[OHOS HDR] output_hdr=" << hdr << " p3=" << p3 << " bits=" << red << ","
+              << alpha << " colorspace_result=" << color_result
+              << " metadata_result=" << metadata_result;
+    if (color_result != 0 || metadata_result != 0) {
+      return false;
+    }
+  }
+
+  TRACE_EVENT0("gpu", "NativeViewGLSurfaceEGLOhos::Resize");
+
+  int32_t ret = OH_NativeWindow_NativeWindowHandleOpt(reinterpret_cast<OHNativeWindow*>(window_),
+                                                      SET_BUFFER_GEOMETRY,
+                                                      size_.width(),
+                                                      size_.height());
+  if (ret != 0) {
+    LOG(ERROR) << "NativeViewGLSurfaceEGLOhos::Resize error: " << ret;
+    return false;
+  }
+  return true;
+}
+
+}  // namespace gl
