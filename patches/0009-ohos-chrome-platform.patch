+
+void CollectBookmarks(const bookmarks::BookmarkNode* node,
+                      int depth,
+                      const std::set<int64_t>& expanded,
+                      bool searching,
+                      std::vector<Entry>* entries) {
+  if (!node || entries->size() >= 500) {
+    return;
+  }
+  if (node->is_url()) {
+    entries->push_back({node->GetTitle(), base::UTF8ToUTF16(node->url().host()),
+                        node->url(), false, {}, node->id(), depth});
+    return;
+  }
+  if (node->children().empty()) {
+    return;
+  }
+  if (!searching) {
+    entries->push_back({node->GetTitle(), {}, {}, true, {}, node->id(), depth});
+    if (!expanded.contains(node->id())) {
+      return;
+    }
+  }
+  for (const auto& child : node->children()) {
+    CollectBookmarks(child.get(), depth + 1, expanded, searching, entries);
+  }
+}
