+views::Widget::InitParams BrowserNativeWidgetAuraOhos::GetWidgetParams(
+    views::Widget::InitParams::Ownership ownership) {
+  auto params = BrowserNativeWidgetAura::GetWidgetParams(ownership);
+  auto* browser = browser_view()->browser();
+  const auto type = browser->GetType();
+  params.remove_standard_frame =
+      type != BrowserWindowInterface::Type::TYPE_DEVTOOLS &&
+      type != BrowserWindowInterface::Type::TYPE_POPUP;
+  if (auto* app_controller = web_app::AppBrowserController::From(browser)) {
+    params.app_id = app_controller->app_id();
+  }
+  return params;
+}
