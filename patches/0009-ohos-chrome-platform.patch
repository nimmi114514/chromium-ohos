+bool BrowserNativeWidgetAuraOhos::UseCustomFrame() const {
+  return false;
+}
+
+bool BrowserNativeWidgetAuraOhos::ShouldSaveWindowPlacement() const {
+  using ohos::adapter::device_info::DeviceInfo;
+  using ohos::adapter::device_info::DeviceType;
+  return DeviceInfo::GetInstance().GetDeviceType() == DeviceType::_2IN1 &&
+         !IsMinimized();
+}
+
+void BrowserNativeWidgetAuraOhos::GetWindowPlacement(
+    gfx::Rect* bounds, ui::mojom::WindowShowState* show_state) const {
+  *bounds = GetWidget()->GetRestoredBounds();
+  *show_state = IsMaximized() ? ui::mojom::WindowShowState::kMaximized
+                             : ui::mojom::WindowShowState::kNormal;
+}
+
+BrowserNativeWidget* BrowserNativeWidgetFactory::Create(
+    BrowserWidget* browser_widget, BrowserView* browser_view) {
+  return new BrowserNativeWidgetAuraOhos(browser_widget, browser_view);
+}
