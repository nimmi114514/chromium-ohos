+ private:
+  void DetachModelAndTasks() {
+    closing_ = true;
+    model_observation_.Reset();
+    history_task_tracker_.TryCancelAll();
+    weak_factory_.InvalidateWeakPtrs();
+  }
+
+  void ScheduleBookmarkRefresh() {
+    if (closing_ || bookmark_refresh_pending_) {
+      return;
+    }
+    bookmark_refresh_pending_ = true;
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(
+                       &HistoryBookmarksBubbleView::RunBookmarkRefresh,
+                       weak_factory_.GetWeakPtr()));
+  }
+
+  void RunBookmarkRefresh() {
+    bookmark_refresh_pending_ = false;
+    RefreshBookmarks();
+  }
+
+  void LoadHistory() {
+    if (closing_ || !browser_) {
+      return;
+    }
+    history::HistoryService* history_service =
+        HistoryServiceFactory::GetForProfile(
+            browser_->GetProfile(), ServiceAccessType::EXPLICIT_ACCESS);
+    if (!history_service) {
+      RebuildRows({}, l10n_util::GetStringUTF16(IDS_HISTORY_NO_RESULTS));
+      return;
+    }
+    RebuildRows({}, l10n_util::GetStringUTF16(IDS_HISTORY_LOADING));
+    history::QueryOptions options;
+    options.max_count = kMaxRows;
+    options.duplicate_policy = history::QueryOptions::REMOVE_ALL_DUPLICATES;
+    options.visit_order = history::QueryOptions::RECENT_FIRST;
+    if (history_range_ == 1) {
+      options.begin_time = base::Time::Now().LocalMidnight();
+    } else if (history_range_ == 2) {
+      options.begin_time = base::Time::Now() - base::Days(7);
+    }
+    history_service->QueryHistory(
+        std::u16string(search_field_->GetText()), options,
+        base::BindOnce(&HistoryBookmarksBubbleView::OnHistoryLoaded,
+                       weak_factory_.GetWeakPtr()),
+        &history_task_tracker_);
+  }
+
+  void OnHistoryLoaded(history::QueryResults results) {
+    history_entries_.clear();
+    std::vector<Entry> entries;
+    entries.reserve(std::min(results.size(), kMaxRows));
+    for (const auto& result : results) {
+      if (entries.size() >= kMaxRows) {
+        break;
+      }
+      std::u16string title = result.title();
+      if (title.empty()) {
+        title = base::UTF8ToUTF16(result.url().host());
+      }
+      std::u16string subtitle = base::TimeFormatTimeOfDay(result.visit_time());
+      const std::u16string host = base::UTF8ToUTF16(result.url().host());
+      if (!host.empty()) {
+        subtitle += u" · " + host;
+      }
+      const base::Time today = base::Time::Now().LocalMidnight();
+      const base::Time yesterday = today - base::Days(1);
+      std::u16string group;
+      if (result.visit_time() >= today) {
+        group = u"今天";
+      } else if (result.visit_time() >= yesterday) {
+        group = u"昨天";
+      } else {
+        group = base::TimeFormatShortDate(result.visit_time());
+      }
+      Entry entry{std::move(title), std::move(subtitle), result.url(), false,
+                  std::move(group)};
+      history_entries_.push_back(entry);
+      entries.push_back(std::move(entry));
+    }
+    RebuildRows(entries, entries.empty()
+                             ? l10n_util::GetStringUTF16(IDS_HISTORY_NO_RESULTS)
+                             : std::u16string());
+  }
+
+  void LoadBookmarks() {
+    if (!browser_) {
+      return;
+    }
+    bookmarks::BookmarkModel* model =
+        BookmarkModelFactory::GetForBrowserContext(browser_->GetProfile());
+    if (!model) {
+      RebuildRows({},
+                  l10n_util::GetStringUTF16(IDS_BOOKMARK_MANAGER_EMPTY_LIST));
+      return;
+    }
+    if (!model->loaded()) {
+      model_observation_.Observe(model);
+      RebuildRows({}, l10n_util::GetStringUTF16(IDS_HISTORY_LOADING));
+      return;
+    }
+    RefreshBookmarks();
+  }
+
+  void BookmarkModelChanged() override { ScheduleBookmarkRefresh(); }
+
+  void BookmarkModelBeingDeleted() override {
+    model_observation_.Reset();
+    if (closing_) {
+      return;
+    }
+    RebuildRows({}, l10n_util::GetStringUTF16(IDS_BOOKMARK_MANAGER_EMPTY_LIST));
+  }
+
+  void RefreshBookmarks() {
+    if (closing_ || !browser_) {
+      return;
+    }
+    bookmarks::BookmarkModel* model =
+        BookmarkModelFactory::GetForBrowserContext(browser_->GetProfile());
+    if (!model || !model->loaded()) {
+      return;
+    }
+    std::vector<Entry> entries;
+    bookmark_entries_.clear();
+    for (const auto& root_child : model->root_node()->children()) {
+      if (!bookmarks_initialized_) {
+        expanded_folders_.insert(root_child->id());
+      }
+      CollectBookmarks(root_child.get(), 0, expanded_folders_,
+                       !search_field_->GetText().empty(), &entries);
+      if (entries.size() >= kMaxRows) {
+        break;
+      }
+    }
+    if (!model_observation_.IsObserving()) {
+      model_observation_.Observe(model);
+    }
+    bookmarks_initialized_ = true;
+    bookmark_entries_ = entries;
+    FilterBookmarks();
+  }
+
+  void ContentsChanged(views::Textfield* sender,
+                       const std::u16string& new_contents) override {
+    if (type_ == BubbleType::kHistory) {
+      LoadHistory();
+    } else {
+      RefreshBookmarks();
+    }
+  }
+
+  void SetHistoryRange(int range) {
+    history_range_ = range;
+    for (size_t i = 0; i < range_buttons_.size(); ++i) {
+      const bool selected = static_cast<int>(i) == range;
+      range_buttons_[i]->SetStyle(selected ? ui::ButtonStyle::kTonal
+                                            : ui::ButtonStyle::kText);
+    }
+    LoadHistory();
+  }
+
+  void FilterBookmarks() {
+    std::vector<Entry> filtered;
+    const std::u16string query(search_field_->GetText());
+    for (const Entry& entry : bookmark_entries_) {
+      if (query.empty() || entry.title.find(query) != std::u16string::npos ||
+          entry.subtitle.find(query) != std::u16string::npos ||
+          base::UTF8ToUTF16(entry.url.spec()).find(query) !=
+              std::u16string::npos) {
+        filtered.push_back(entry);
+      }
+    }
+    RebuildRows(filtered, filtered.empty()
+                              ? l10n_util::GetStringUTF16(
+                                    IDS_BOOKMARK_MANAGER_EMPTY_LIST)
+                              : std::u16string());
+  }
+
+  void RebuildRows(const std::vector<Entry>& entries,
+                   const std::u16string& empty_message) {
+    list_view_->RemoveAllChildViews();
+    if (footer_count_) {
+      footer_count_->SetText(type_ == BubbleType::kHistory
+                                 ? u"最近 " +
+                                       base::NumberToString16(entries.size()) +
+                                       u" 条"
+                                 : base::NumberToString16(entries.size()) +
+                                       u" 项");
+    }
+    if (entries.empty()) {
+      auto* empty = list_view_->AddChildView(
+          std::make_unique<views::Label>(empty_message));
+      empty->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+      empty->SetMultiLine(true);
+      empty->SetBorder(views::CreateEmptyBorder(gfx::Insets(12)));
+      return;
+    }
+    std::u16string previous_group;
+    for (const Entry& entry : entries) {
+      if (type_ == BubbleType::kHistory && entry.group != previous_group) {
+        auto* group_label = list_view_->AddChildView(
+            std::make_unique<views::Label>(entry.group));
+        group_label->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+        group_label->SetFontList(group_label->font_list().Derive(
+            -1, gfx::Font::NORMAL, gfx::Font::Weight::MEDIUM));
+        group_label->SetEnabledColor(ui::kColorLabelForegroundSecondary);
+        group_label->SetBorder(
+            views::CreateEmptyBorder(gfx::Insets::TLBR(9, 12, 3, 0)));
+        previous_group = entry.group;
+      }
+      if (type_ == BubbleType::kHistory) {
+        std::unique_ptr<views::Button> row =
+            std::make_unique<HistoryRowButton>(
+            base::BindRepeating(&HistoryBookmarksBubbleView::OpenEntry,
+                                weak_factory_.GetWeakPtr(), entry.url));
+        auto* row_layout = row->SetLayoutManager(std::make_unique<views::BoxLayout>(
+            views::BoxLayout::Orientation::kHorizontal,
+            gfx::Insets::VH(4, 10), 12));
+        row->SetPreferredSize(gfx::Size(kContentWidth, kHistoryRowHeight));
+
+        auto* icon = row->AddChildView(std::make_unique<views::ImageView>());
+        icon->SetImage(ui::ImageModel::FromVectorIcon(
+            kScheduleIcon, ui::kColorLabelForegroundSecondary, 19));
+        auto* text_container = row->AddChildView(std::make_unique<views::View>());
+        auto* text_layout = text_container->SetLayoutManager(
+            std::make_unique<views::BoxLayout>(
+                views::BoxLayout::Orientation::kVertical));
+        text_layout->set_cross_axis_alignment(
+            views::BoxLayout::CrossAxisAlignment::kStretch);
+        auto* title = text_container->AddChildView(
+            std::make_unique<views::Label>(
+                entry.title, views::style::CONTEXT_DIALOG_BODY_TEXT,
+                views::style::STYLE_PRIMARY));
+        title->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+        title->SetTextStyle(views::style::STYLE_BODY_3_MEDIUM);
+        title->SetEnabledColor(ui::kColorLabelForeground);
+        title->SetElideBehavior(gfx::ELIDE_TAIL);
+        auto* subtitle = text_container->AddChildView(
+            std::make_unique<views::Label>(entry.subtitle));
+        subtitle->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+        subtitle->SetTextStyle(views::style::STYLE_BODY_5);
+        subtitle->SetEnabledColor(ui::kColorLabelForegroundSecondary);
+        subtitle->SetElideBehavior(gfx::ELIDE_TAIL);
+        text_layout->SetFlexForView(title, 1);
+        text_layout->SetFlexForView(subtitle, 1);
+        row_layout->SetFlexForView(text_container, 1);
+        row->GetViewAccessibility().SetName(entry.title);
+        list_view_->AddChildView(std::move(row));
+        continue;
+      }
+      auto callback = entry.is_folder
+                          ? base::BindRepeating(
+                                &HistoryBookmarksBubbleView::ToggleFolder,
+                                weak_factory_.GetWeakPtr(), entry.node_id)
+                          : base::BindRepeating(
+                                &HistoryBookmarksBubbleView::OpenEntry,
+                                weak_factory_.GetWeakPtr(), entry.url);
+      std::unique_ptr<views::Button> row =
+          std::make_unique<HistoryRowButton>(std::move(callback));
+      auto* row_layout = row->SetLayoutManager(
+          std::make_unique<views::BoxLayout>(
+              views::BoxLayout::Orientation::kHorizontal,
+              gfx::Insets::TLBR(0, 4 + entry.depth * 16, 0, 8), 8));
+      row->SetPreferredSize(gfx::Size(kContentWidth, kBookmarkRowHeight));
+      const bool expanded = expanded_folders_.contains(entry.node_id);
+      auto* arrow = row->AddChildView(std::make_unique<views::ImageView>());
+      arrow->SetPreferredSize(gfx::Size(16, 16));
+      if (entry.is_folder) {
+        arrow->SetImage(ui::ImageModel::FromVectorIcon(
+            expanded ? kKeyboardArrowDownIcon : kChevronRightIcon,
+            ui::kColorIcon, 16));
+      }
+      auto* icon = row->AddChildView(std::make_unique<views::ImageView>());
+      icon->SetImage(ui::ImageModel::FromVectorIcon(
+          entry.is_folder ? vector_icons::kFolderFlippableIcon : kGlobeIcon,
+          ui::kColorIcon, 18));
+      auto* title = row->AddChildView(
+          std::make_unique<views::Label>(entry.title));
+      title->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+      title->SetEnabledColor(ui::kColorLabelForeground);
+      title->SetElideBehavior(gfx::ELIDE_TAIL);
+      row_layout->SetFlexForView(title, 1);
+      row->GetViewAccessibility().SetName(
+          entry.title + (entry.is_folder ? (expanded ? u"，已展开" : u"，已收起")
+                                        : u""));
+      list_view_->AddChildView(std::move(row));
+    }
+    list_view_->InvalidateLayout();
+    scroll_view_->InvalidateLayout();
+  }
+
+  std::u16string GetTitle() const {
+    return gfx::RemoveAccelerator(l10n_util::GetStringUTF16(
+        type_ == BubbleType::kHistory ? IDS_HISTORY_MENU
+                                      : IDS_BOOKMARK_MANAGER_TITLE));
+  }
+
+  std::u16string GetFooterTitle() const {
+    return type_ == BubbleType::kHistory ? u"完整的历史记录"
+                                         : u"打开书签管理器";
+  }
+
+  void ConfigureHeaderButton(views::ImageButton* button) {
+    views::InstallCircleHighlightPathGenerator(button);
+    button->SetProperty(views::kCrossAxisAlignmentKey,
+                        views::LayoutAlignment::kStart);
+    button->SetBorder(nullptr);
+  }
+
+  void AddHeaderManagerButton(views::View* header) {
+    auto manager_button = views::CreateVectorImageButtonWithNativeTheme(
+        base::BindRepeating(&HistoryBookmarksBubbleView::CloseBubble,
+                            weak_factory_.GetWeakPtr()),
+        features::IsRoundedIconsEnabled()
+            ? vector_icons::kCloseIcon
+            : vector_icons::kCloseChromeRefreshOldIcon,
+        GetLayoutConstant(LayoutConstant::kDownloadIconSize));
+    ConfigureHeaderButton(manager_button.get());
+    SetInitiallyFocusedView(manager_button.get());
+    manager_button->SetTooltipText(l10n_util::GetStringUTF16(IDS_APP_CLOSE));
+    manager_button->SetBorder(nullptr);
+    header->AddChildView(std::move(manager_button));
+  }
+
+  void CloseBubble() {
+    DetachModelAndTasks();
+    GetWidget()->Close();
+  }
+
+  void ToggleFolder(int64_t id) {
+    if (expanded_folders_.contains(id)) {
+      expanded_folders_.erase(id);
+    } else {
+      expanded_folders_.insert(id);
+    }
+    ScheduleBookmarkRefresh();
+  }
+
+  void AddCurrentBookmark() {
+    if (closing_ || !browser_ || !chrome::CanBookmarkCurrentTab(browser_.get())) {
+      return;
+    }
+    // Follow the regular star-button path after dismissing this popup. It
+    // handles supported URLs, policy, duplicate bookmarks and the edit dialog.
+    auto browser = browser_;
+    DetachModelAndTasks();
+    GetWidget()->Close();
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce([](base::WeakPtr<BrowserWindowInterface> browser) {
+          if (browser && chrome::CanBookmarkCurrentTab(browser.get())) {
+            chrome::BookmarkCurrentTab(browser.get());
+          }
+        }, std::move(browser)));
+  }
+
+  void OpenEntry(const GURL& url) {
+    if (closing_ || !browser_) {
+      return;
+    }
+    const GURL target(url);
+    auto browser = browser_;
+    DetachModelAndTasks();
+    GetWidget()->Close();
+    if (browser) {
+      browser->OpenGURL(target, WindowOpenDisposition::CURRENT_TAB);
+    }
+  }
+
+  void OpenFullPage() {
+    if (closing_ || !browser_) {
+      return;
+    }
+    const GURL url(type_ == BubbleType::kHistory
+                       ? chrome::kChromeUIHistoryURL
+                       : chrome::kChromeUIBookmarksURL);
+    auto browser = browser_;
+    DetachModelAndTasks();
+    GetWidget()->Close();
+    if (browser) {
+      browser->OpenGURL(url, WindowOpenDisposition::NEW_FOREGROUND_TAB);
+    }
+  }
+
+  base::WeakPtr<BrowserWindowInterface> browser_;
+  const BubbleType type_;
+  bool closing_ = false;
+  bool bookmark_refresh_pending_ = false;
+  raw_ptr<views::View> list_view_ = nullptr;
+  raw_ptr<views::ScrollView> scroll_view_ = nullptr;
+  std::set<int64_t> expanded_folders_;
+  bool bookmarks_initialized_ = false;
+  raw_ptr<views::Textfield> search_field_ = nullptr;
+  raw_ptr<views::Label> section_label_ = nullptr;
+  raw_ptr<views::Label> footer_count_ = nullptr;
+  std::vector<raw_ptr<views::MdTextButton>> range_buttons_;
+  std::vector<Entry> bookmark_entries_;
+  std::vector<Entry> history_entries_;
+  int history_range_ = 0;
+  base::CancelableTaskTracker history_task_tracker_;
+  base::ScopedObservation<bookmarks::BookmarkModel,
+                          bookmarks::BookmarkModelObserver>
+      model_observation_{this};
+  base::WeakPtrFactory<HistoryBookmarksBubbleView> weak_factory_{this};
+};
+
+// Own the non-View delegate and its Widget together. The Widget's contents
+// must be destroyed before the delegate, and model observation must end before
+// either is destroyed. Defer deletion until the current input callback returns.
+class HistoryBookmarksBubbleHost {
+ public:
+  HistoryBookmarksBubbleHost(views::BubbleAnchor anchor,
+                            BrowserWindowInterface* browser,
+                            BubbleType type)
+      : delegate_(std::make_unique<HistoryBookmarksBubbleView>(
+            std::move(anchor), browser, type)) {
+    widget_ = views::BubbleDialogDelegate::CreateBubble(
+        delegate_.get(),
+        base::BindOnce(&HistoryBookmarksBubbleHost::Close,
+                       base::Unretained(this)));
+  }
+  ~HistoryBookmarksBubbleHost() {
+    widget_.reset();
+    delegate_.reset();
+  }
+  void Show() { widget_->Show(); }
+
+ private:
+  void Close(views::Widget::ClosedReason reason) {
+    if (closing_) {
+      return;
+    }
+    closing_ = true;
+    delegate_->PrepareForClose();
+    base::SingleThreadTaskRunner::GetCurrentDefault()->DeleteSoon(FROM_HERE,
+                                                                this);
+  }
+  bool closing_ = false;
+  std::unique_ptr<HistoryBookmarksBubbleView> delegate_;
+  std::unique_ptr<views::Widget> widget_;
+};
+
+}  // namespace
+
+bool ShowHistoryOrBookmarksBubble(BrowserWindowInterface* browser,
+                                  views::BubbleAnchor anchor,
+                                  actions::ActionId action_id) {
+  if (!browser || anchor.IsNull()) {
+    return false;
+  }
+
+  BubbleType type;
+  if (action_id == kActionSidePanelShowBookmarks) {
+    type = BubbleType::kBookmarks;
+  } else if (action_id == kActionSidePanelShowHistory ||
+             action_id == kActionSidePanelShowHistoryCluster) {
+    type = BubbleType::kHistory;
+  } else {
+    return false;
+  }
+
+  (new HistoryBookmarksBubbleHost(std::move(anchor), browser, type))->Show();
+  return true;
+}
