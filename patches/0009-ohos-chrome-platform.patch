--- /dev/null
+++ b/chrome/browser/fullscreen_ohos.cc
@@ -0,0 +1,30 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/fullscreen.h"
+
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/browser_window/public/global_browser_collection.h"
+#include "ui/base/base_window.h"
+
+// OHOS owns application windows through its ability. Like the original Ozone
+// fallback, check Chromium's browser windows rather than a desktop window
+// server when deciding whether notification popups may appear.
+bool IsFullScreenMode() {
+  auto* browsers = GlobalBrowserCollection::GetInstance();
+  if (!browsers) {
+    return false;
+  }
+
+  bool fullscreen = false;
+  browsers->ForEach([&fullscreen](BrowserWindowInterface* browser) {
+    ui::BaseWindow* window = browser->GetWindow();
+    if (window && window->IsFullscreen()) {
+      fullscreen = true;
+      return false;
+    }
+    return true;
+  });
+  return fullscreen;
+}
