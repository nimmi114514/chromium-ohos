+ 
+namespace {
+constexpr int kDefaultCaptionButtonWidth = 140;
+}  // namespace
+ 
+BrowserFrameViewOhos::BrowserFrameViewOhos(BrowserWidget* widget,
+                                           BrowserView* browser_view,
+                                           OpaqueBrowserFrameViewLayout* layout)
+    : OpaqueBrowserFrameView(widget, browser_view, layout) {}
+ 
+bool BrowserFrameViewOhos::CaptionButtonsOnLeadingEdge() const {
+  return base::i18n::IsRTL();
+}
+
+BrowserFrameView::BoundsAndMargins
+BrowserFrameViewOhos::GetCaptionButtonBounds() const {
+  const int caption_width = CaptionButtonsRegionWidth();
+  // Vertical tabs put the toolbar in the caption row instead of a horizontal
+  // tabstrip. Keep the native button exclusion non-empty in both layouts.
+  const int button_height = GetClientFrameElementInfo().top_area_height();
+  return {gfx::RectF(CaptionButtonsOnLeadingEdge()
+                        ? 0 : std::max(0, width() - caption_width),
+                    0, caption_width, button_height), {}};
+}
+
+int BrowserFrameViewOhos::CaptionButtonsRegionWidth() const {
+  auto* window = GetBrowserView()->GetNativeWindow();
+  auto* host = window ? static_cast<aura::WindowTreeHostPlatform*>(
+                            window->GetHost()) : nullptr;
+  if (host && host->platform_window()) {
+    const auto caption_button_rect = host->platform_window()->GetCaptionButtonRect();
+    const auto display = display::Screen::Get()->GetDisplayNearestWindow(window);
+    return display::ohos::ScreenOhos::ConvertPixelToDIP(display, caption_button_rect).width();
+  }
+  return kDefaultCaptionButtonWidth;
+}
