+    OH_AVFormat_GetIntValue(av_format, OH_MD_KEY_TRANSFER_CHARACTERISTICS, &format.color_transfer);
+    OH_AVFormat_GetIntValue(av_format, OH_MD_KEY_MATRIX_COEFFICIENTS, &format.color_matrix);
+    OH_AVFormat_GetIntValue(av_format, OH_MD_KEY_RANGE_FLAG, &format.full_range);
+    OH_AVFormat_GetIntValue(av_format, OH_MD_KEY_PIXEL_FORMAT, &format.pixel_format);
+    OH_AVFormat_Destroy(av_format);
