+    : classic_discovery_manager_(
+          BluetoothDiscoveryManagerOhos::CreateClassic(this)) {
+  DCHECK(classic_discovery_manager_);
+  ui_task_runner_ = base::TaskRunnerOHOS::GetUIThreadTaskRunner();
+  DCHECK(ui_task_runner_);
+}
