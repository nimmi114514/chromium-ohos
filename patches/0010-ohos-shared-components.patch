+bool UsbDeviceHandleUsbfs::BlockingTaskRunnerHelper::DetachHidInterface(
+    int interface_number) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  usbdevfs_getdriver driver = {};
+  driver.interface = interface_number;
+  if (HANDLE_EINTR(ioctl(fd_.get(), USBDEVFS_GETDRIVER, &driver)) < 0) {
+    return errno == ENODATA;
+  }
+  usbdevfs_ioctl request = {};
+  request.ifno = interface_number;
+  request.ioctl_code = USBDEVFS_DISCONNECT;
+  if (HANDLE_EINTR(ioctl(fd_.get(), USBDEVFS_IOCTL, &request)) < 0) {
+    return errno == ENODATA;
+  }
+  detached_hid_interfaces_.insert(interface_number);
+  return true;
+}
+
+bool UsbDeviceHandleUsbfs::BlockingTaskRunnerHelper::ReattachHidInterface(
+    int interface_number) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!detached_hid_interfaces_.contains(interface_number)) {
+    return true;
+  }
+  usbdevfs_ioctl request = {};
+  request.ifno = interface_number;
+  request.ioctl_code = USBDEVFS_CONNECT;
+  const int result = HANDLE_EINTR(ioctl(fd_.get(), USBDEVFS_IOCTL, &request));
+  if (result < 0) {
+    USB_PLOG(ERROR) << "OHOS HID driver restore failed, interface="
+                    << interface_number;
+    return false;
+  }
+  // USBDEVFS_CONNECT may return a positive number when a driver was bound.
+  // Match the existing Linux/Android ReattachInterface contract (rc >= 0).
+  detached_hid_interfaces_.erase(interface_number);
+  USB_LOG(EVENT) << "OHOS HID driver restored, interface=" << interface_number
+                 << " result=" << result;
+  return true;
+}
