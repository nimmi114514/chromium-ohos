+OHOSCaptureDelegate::OHOSCaptureDelegate(
+    const VideoCaptureDeviceDescriptor& device_descriptor,
+    const scoped_refptr<base::SingleThreadTaskRunner>& capture_stask_runner,
+    const VideoCaptureParams capture_params)
+    : capture_task_runner_(capture_stask_runner),
+      device_descriptor_(device_descriptor),
+      is_capturing_(false),
+      capture_params_(capture_params) {}
+
+void OHOSCaptureDelegate::AllocateAndStart(
+    std::unique_ptr<VideoCaptureDevice::Client> client) {
+  DCHECK(capture_task_runner_->BelongsToCurrentThread());
+  DCHECK(client);
+
+  client_ = std::move(client);
+  OH_Camera_GetCameraManager(&camera_manager_);
+  if (!camera_manager_ || !StartStream()) {
+    StopStream();
+    SetErrorState(VideoCaptureError::kVideoCaptureSystemDeviceIdNotFound,
+                  FROM_HERE, "Failed to start OHOS camera");
+    return;
+  }
+  auto& media_adapter_instance = ohos::adapter::MediaAdapter::GetInstance();
+  auto frame_pending = std::make_shared<std::atomic<bool>>(false);
+  media_adapter_instance.RegisterBufferAvailableCallback(
+      [task_runner = capture_task_runner_, weak = weak_factory_.GetWeakPtr(),
+       frame_pending](uint8_t* data, size_t size) {
+        if (!data || size == 0 || size > 64 * 1024 * 1024 ||
+            frame_pending->exchange(true)) {
+          return;
+        }
+        // The ImageReceiver owns this memory and releases it after this
+        // callback. Copy one frame before posting to the capture sequence.
+        auto source = UNSAFE_BUFFERS(base::span(data, size));
+        std::vector<uint8_t> frame(source.begin(), source.end());
+        const bool posted = task_runner->PostTask(
+            FROM_HERE,
+            base::BindOnce(
+                [](base::WeakPtr<OHOSCaptureDelegate> delegate,
+                   std::shared_ptr<std::atomic<bool>> pending,
+                   std::vector<uint8_t> bytes) {
+                  if (delegate) {
+                    delegate->OnBufferAvailable(bytes.data(), bytes.size());
+                  }
+                  pending->store(false);
+                },
+                weak, frame_pending, std::move(frame)));
+        if (!posted) {
+          frame_pending->store(false);
+        }
+      });
+  client_->OnStarted();
+}
+
+void OHOSCaptureDelegate::StopAndDeAllocate() {
+  DCHECK(capture_task_runner_->BelongsToCurrentThread());
+
+  ohos::adapter::MediaAdapter::GetInstance().RegisterBufferAvailableCallback({});
+  weak_factory_.InvalidateWeakPtrs();
+  StopStream();
+  // At this point we can close the device.
+  // This is also needed for correctly changing settings later via VIDIOC_S_FMT.
+  client_.reset();
+  if (camera_manager_) {
+    OH_Camera_DeleteCameraManager(camera_manager_);
+    camera_manager_ = nullptr;
+  }
+}
+
+void OHOSCaptureDelegate::InvalidateBuffers() {
+  DCHECK(capture_task_runner_->BelongsToCurrentThread());
+  if (client_) {
+    client_->InvalidateBuffers();
+  }
+}
