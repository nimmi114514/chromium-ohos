+    // initialization diagnostics in the application's normal graphics log.
+    dawn_instance_desc.SetLoggingCallback(
+        [](wgpu::LoggingType type, wgpu::StringView message) {
+          const std::string_view text(message.data, message.length);
+          if (type == wgpu::LoggingType::Error) {
+            LOG(ERROR) << "Dawn: " << text;
+          } else if (type == wgpu::LoggingType::Warning) {
+            LOG(WARNING) << "Dawn: " << text;
+          }
+        });
+  }
+#endif
   dawn_instance_desc.nextInChain = &dawn_toggle_desc;
   dawn_instance_desc.platform = platform;
 
