+UsbDeviceOhos::UsbDeviceOhos(const USBDevice& usb_device_info,
+                             mojom::UsbDeviceInfoPtr device_info)
+    : UsbDevice(std::move(device_info)), usb_device_info_(usb_device_info) {}
+
+UsbDeviceOhos::~UsbDeviceOhos() = default;
+
+scoped_refptr<UsbDeviceOhos> UsbDeviceOhos::CreateForHid(const USBDevice& device) {
+  auto info = mojom::UsbDeviceInfo::New();
+  info->vendor_id = device.vendorId;
+  info->product_id = device.productId;
+  info->manufacturer_name = base::UTF8ToUTF16(device.manufacturerName);
+  info->product_name = base::UTF8ToUTF16(device.productName);
+  info->serial_number = base::UTF8ToUTF16(device.serial);
+  info->bus_number = device.busNum;
+  info->port_number = device.devAddress;
+  return base::WrapRefCounted(new UsbDeviceOhos(device, std::move(info)));
+}
+
+void UsbDeviceOhos::Open(OpenCallback callback) {
+  auto blocking_task_runner = UsbService::CreateBlockingTaskRunner();
+  blocking_task_runner->PostTask(
+      FROM_HERE,
+      base::BindOnce(&UsbDeviceOhos::OpenOnBlockingThread, this,
+                     std::move(callback),
+                     base::SequencedTaskRunner::GetCurrentDefault(),
+                     blocking_task_runner));
+}
+
+void UsbDeviceOhos::OpenOnBlockingThread(
+    OpenCallback callback,
+    scoped_refptr<base::SequencedTaskRunner> task_runner,
+    scoped_refptr<base::SequencedTaskRunner> blocking_task_runner) {
+  auto fail = [&] {
+    task_runner->PostTask(FROM_HERE,
+                         base::BindOnce(std::move(callback), nullptr));
+  };
+  USB_LOG(EVENT) << "OHOS USB open: checking access, device=" << device_id();
+  const bool has_right = DeviceAdapter::HasRight(device_id());
+  USB_LOG(EVENT) << "OHOS USB access cached=" << has_right;
+  if (!has_right) {
+    USB_LOG(EVENT) << "OHOS USB requesting system authorization";
+    const bool granted = DeviceAdapter::RequestRight(device_id());
+    USB_LOG(EVENT) << "OHOS USB authorization result=" << granted;
+    if (!granted) {
+      fail();
+      return;
+    }
+  }
+  USB_LOG(EVENT) << "OHOS USB connecting system device pipe";
+  ohos::adapter::device::USBDevicePipe pipe;
+  if (!DeviceAdapter::OpenDevice(usb_device_info_, pipe)) {
+    fail();
+    return;
+  }
+  USB_LOG(EVENT) << "OHOS USB device pipe connected";
+  // USBManager owns the original descriptor. Duplicate before closing its pipe.
+  const int borrowed_fd = DeviceAdapter::GetFileDescriptor(pipe);
+  USB_LOG(EVENT) << "OHOS USB system descriptor valid=" << (borrowed_fd >= 0);
+  base::ScopedFD fd(borrowed_fd < 0 ? -1 :
+      HANDLE_EINTR(fcntl(borrowed_fd, F_DUPFD_CLOEXEC, 0)));
+  std::vector<uint8_t> descriptor_vector =
+      DeviceAdapter::GetRawDescriptor(pipe);
+  USB_LOG(EVENT) << "OHOS USB raw descriptor bytes=" << descriptor_vector.size();
+  DeviceAdapter::ClosePipe(pipe);
+  USB_LOG(EVENT) << "OHOS USB system pipe closed, private descriptor retained";
+  if (!fd.is_valid()) {
+    fail();
+    return;
+  }
+  std::unique_ptr<UsbDeviceDescriptor> descriptor =
+      std::make_unique<UsbDeviceDescriptor>();
+  if (descriptor_vector.size() < USB_DT_DEVICE_SIZE ||
+      descriptor_vector[1] != USB_DT_DEVICE ||
+      !descriptor->Parse(base::span(descriptor_vector)) ||
+      descriptor->device_info->configurations.empty()) {
+    USB_LOG(ERROR) << "OHOS USB raw descriptor parse failed";
+    fail();
+    return;
+  }
+
+  if (descriptor->device_info->class_code == K_DEVICE_CLASS_HUB) {
+    // Don't try to enumerate hubs. We never want to connect to a hub.
+    fail();
+    return;
+  }
+
+  descriptor->device_info->manufacturer_name = device_info_->manufacturer_name;
+  descriptor->device_info->product_name = device_info_->product_name;
+  descriptor->device_info->serial_number = device_info_->serial_number;
+  descriptor->device_info->bus_number = device_info_->bus_number;
+  descriptor->device_info->port_number = device_info_->port_number;
+  uint8_t active_configuration = 0;
+  usbdevfs_ctrltransfer request = {};
+  request.bRequestType = USB_DIR_IN | USB_TYPE_STANDARD | USB_RECIP_DEVICE;
+  request.bRequest = USB_REQ_GET_CONFIGURATION;
+  request.wLength = 1;
+  request.timeout = 1000;
+  request.data = &active_configuration;
+  USB_LOG(EVENT) << "OHOS USB reading active configuration";
+  if (HANDLE_EINTR(ioctl(fd.get(), USBDEVFS_CONTROL, &request)) != 1) {
+    USB_PLOG(ERROR) << "Unable to read active USB configuration";
+    fail();
+    return;
+  }
+  USB_LOG(EVENT) << "OHOS USB active configuration="
+                 << static_cast<int>(active_configuration);
+  descriptor->device_info->active_configuration = active_configuration;
+  std::string empty_client_id = "";
+  if (fd.is_valid()) {
+    task_runner->PostTask(
+        FROM_HERE, base::BindOnce(&UsbDeviceOhos::Opened, this,
+                                  std::move(descriptor->device_info), std::move(fd),
+                                  base::ScopedFD(), empty_client_id,
+                                  std::move(callback), blocking_task_runner));
+  } else {
+    LOG(WARNING) << "Failed to open " << device_id();
+    task_runner->PostTask(FROM_HERE,
+                          base::BindOnce(std::move(callback), nullptr));
+  }
+}
+
+void UsbDeviceOhos::Opened(
+    mojom::UsbDeviceInfoPtr device_info,
+    base::ScopedFD fd,
+    base::ScopedFD lifeline_fd,
+    const std::string& client_id,
+    OpenCallback callback,
+    scoped_refptr<base::SequencedTaskRunner> blocking_task_runner) {
+  USB_LOG(EVENT) << "OHOS USB constructing usbfs handle";
+  device_info_ = std::move(device_info);
+  scoped_refptr<UsbDeviceHandle> device_handle =
+      new UsbDeviceHandleUsbfs(this, std::move(fd), std::move(lifeline_fd),
+                               client_id, blocking_task_runner);
+  handles().push_back(device_handle.get());
+  std::move(callback).Run(device_handle);
+}
+
+}  // namespace device
