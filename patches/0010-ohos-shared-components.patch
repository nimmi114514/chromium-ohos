+OhosAudioDecoder::OhosAudioDecoder(
+    scoped_refptr<base::SequencedTaskRunner> task_runner,
+    std::unique_ptr<MediaLog> media_log)
+    : state_(kUninitialized),
+      sample_format_(kSampleFormatS16),
