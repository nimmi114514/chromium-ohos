+#include "services/device/public/cpp/generic_sensor/sensor_traits.h"
+
+namespace device {
+
+using mojom::SensorType;
+
+PlatformSensorAccelerometerOhos::PlatformSensorAccelerometerOhos(
+    SensorReadingSharedBuffer* reading_buffer,
+    base::WeakPtr<PlatformSensorProvider> provider,
+    Sensor_Info* sensor_info)
+    : PlatformSensorOhos(SensorType::ACCELEROMETER,
+                         reading_buffer,
+                         std::move(provider),
+                         sensor_info) {
+  auto& instances = PlatformSensorOhos::GetInstances();
+  instances[Sensor_Type::SENSOR_TYPE_ACCELEROMETER] = this;
+}
+
+PlatformSensorAccelerometerOhos::~PlatformSensorAccelerometerOhos() {
+  auto& instances = PlatformSensorOhos::GetInstances();
+  instances.erase(Sensor_Type::SENSOR_TYPE_ACCELEROMETER);
+}
+
+void PlatformSensorAccelerometerOhos::ReadAndUpdate(std::vector<float>& data,
+                                                    uint32_t length) {
+  SensorReading reading;
+  if (!ReadData(data, length, reading)) {
+    return;
+  }
+  UpdateSharedBufferAndNotifyClients(reading);
+}
+
+bool PlatformSensorAccelerometerOhos::ReadData(std::vector<float>& data,
+                                               uint32_t length,
+                                               SensorReading& reading) {
+  if (length != kAccelDataLength) {
+    LOG(WARNING) << "Accelerometer Sensor get data, length error. length: "
+                 << length;
+    return false;
+  }
+  reading.accel.x = data[0];
+  reading.accel.y = data[1];
+  reading.accel.z = data[2];
+  reading.als.timestamp =
+      (base::TimeTicks::Now() - base::TimeTicks()).InSecondsF();
+  return true;
+}
+
+}  // namespace device
