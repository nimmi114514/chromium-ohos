+
+void WebContentsImpl::SetHaveEncryptedMediaForPlayer(
+    bool have_encrypted_media, const void* player) {
+  if (have_encrypted_media && player) {
+    encrypted_media_players_.insert(player);
+  } else if (player) {
+    encrypted_media_players_.erase(player);
+  } else {
+    encrypted_media_players_.clear();
+  }
+  have_encrypted_media_ = !encrypted_media_players_.empty();
+  // Teardown can release protection after the native widget has gone away;
+  // the adapter remembers the OHOS window ID associated with this owner.
+  auto* window = have_encrypted_media_ ? GetTopLevelNativeWindow() : nullptr;
+  const auto widget = window && window->GetHost()
+                          ? window->GetHost()->GetAcceleratedWidget()
+                          : 0;
+  ohos::adapter::xcomponent::WindowAdapter::GetInstance().SetWindowPrivacyMode(
+      widget, have_encrypted_media_, this);
+}
+#endif
+
 }  // namespace content
