+void GamepadPlatformDataFetcherOhos::OnAddedToProvider() {
+  polling_task_runner_ = base::SequencedTaskRunner::GetCurrentDefault();
+  BindHidManager(hid_manager_.BindNewPipeAndPassReceiver());
+  hid_manager_->GetDevicesAndSetClient(
+      hid_manager_client_.BindNewEndpointAndPassRemote(),
+      base::BindOnce(&GamepadPlatformDataFetcherOhos::OnHidDevicesEnumerated,
+                     weak_factory_.GetWeakPtr()));
+  device::RegisterGamepadFetcherCallbacks(this,
+                                          OnDeviceStateFromBridge,
+                                          OnButtonFromBridge,
+                                          OnAxisFromBridge);
+  // Enumerate devices already connected at browser startup.
+  device::EnumerateExistingGamepadDevices();
+}
+
+void GamepadPlatformDataFetcherOhos::PostDeviceStateEvent(
+    const GamepadDeviceStateEvent& event) {
+  // Copy device_name before crossing thread boundary.
+  std::string device_name(event.device_name ? event.device_name : "");
+  // Called on FFRT thread — bridge mutex ensures safety.
+  polling_task_runner_->PostTask(
+      FROM_HERE,
+      base::BindOnce(&GamepadPlatformDataFetcherOhos::HandleDeviceStateEvent,
+                     weak_factory_.GetWeakPtr(), event.device_id,
+                     event.connected, std::move(device_name),
+                     event.vendor_id, event.product_id));
+}
+
+void GamepadPlatformDataFetcherOhos::PostButtonEvent(
+    const GamepadButtonEvent& event) {
+  // Called on FFRT thread — bridge mutex ensures safety.
+  polling_task_runner_->PostTask(
+      FROM_HERE,
+      base::BindOnce(&GamepadPlatformDataFetcherOhos::HandleButtonEvent,
+                     weak_factory_.GetWeakPtr(), event.device_id,
+                     event.button_code, event.pressed));
+}
+
+void GamepadPlatformDataFetcherOhos::PostAxisEvent(
+    const GamepadAxisEvent& event) {
+  // Called on FFRT thread — bridge mutex ensures safety.
+  polling_task_runner_->PostTask(
+      FROM_HERE,
+      base::BindOnce(&GamepadPlatformDataFetcherOhos::HandleAxisEvent,
+                     weak_factory_.GetWeakPtr(), event.device_id,
+                     event.axis_type, event.x, event.y));
+}
+
+void GamepadPlatformDataFetcherOhos::HandleDeviceStateEvent(
+    int32_t device_id,
+    bool connected,
+    const std::string& device_name,
+    uint16_t vendor_id,
+    uint16_t product_id) {
+  DCHECK(polling_task_runner_->RunsTasksInCurrentSequence());
+  if (connected) {
+    OnDeviceConnected(device_id, device_name, vendor_id, product_id);
+  } else {
+    OnDeviceDisconnected(device_id);
+  }
+}
+
+void GamepadPlatformDataFetcherOhos::HandleButtonEvent(int32_t device_id,
+                                                       int button_code,
+                                                       bool pressed) {
+  DCHECK(polling_task_runner_->RunsTasksInCurrentSequence());
+  OnButtonEvent(device_id, button_code, pressed);
+}
+
+void GamepadPlatformDataFetcherOhos::HandleAxisEvent(int32_t device_id,
+                                                     int axis_type,
+                                                     float x,
+                                                     float y) {
+  DCHECK(polling_task_runner_->RunsTasksInCurrentSequence());
+  OnAxisEvent(device_id, axis_type, x, y);
+}
+
+void GamepadPlatformDataFetcherOhos::GetGamepadData(bool devices_changed_hint) {
+  DCHECK(polling_task_runner_->RunsTasksInCurrentSequence());
+  TRACE_EVENT0("GAMEPAD", "GetGamepadData (OHOS)");
+
+  for (const auto& [device_id, device] : devices_) {
+    PadState* state = GetPadState(device_id);
+    if (!state) {
+      continue;
+    }
+
+    Gamepad& pad = state->data;
+    device->ReadPadState(&pad);
+
+    state->is_active = !device->IsEmpty();
+  }
+}
+
+bool GamepadPlatformDataFetcherOhos::DisconnectUnrecognizedGamepad(
+    int source_id) {
+  DCHECK(polling_task_runner_->RunsTasksInCurrentSequence());
+  auto it = devices_.find(source_id);
+  if (it == devices_.end()) {
+    return false;
+  }
+  it->second->Shutdown();
+  devices_.erase(it);
+  return true;
+}
+
+void GamepadPlatformDataFetcherOhos::PlayEffect(
+    int pad_index,
+    mojom::GamepadHapticEffectType type,
+    mojom::GamepadEffectParametersPtr params,
+    mojom::GamepadHapticsManager::PlayVibrationEffectOnceCallback callback,
+    scoped_refptr<base::SequencedTaskRunner> callback_runner) {
+  if (type != mojom::GamepadHapticEffectType::GamepadHapticEffectTypeDualRumble || !params ||
+      !haptic_connections_.contains(pad_index)) {
+    GamepadDataFetcher::RunVibrationCallback(
+        std::move(callback), std::move(callback_runner),
+        mojom::GamepadHapticsResult::GamepadHapticsResultNotSupported);
+    return;
+  }
+
+  const uint64_t sequence = ++vibration_sequences_[pad_index];
+  auto start = base::BindOnce(
+      &GamepadPlatformDataFetcherOhos::StartRumbleEffect,
+      weak_factory_.GetWeakPtr(), pad_index, params->strong_magnitude,
+      params->weak_magnitude, base::Seconds(params->duration), sequence,
+      std::move(callback), std::move(callback_runner));
+  const base::TimeDelta delay = base::Seconds(params->start_delay);
+  if (delay.is_positive()) {
+    polling_task_runner_->PostDelayedTask(FROM_HERE, std::move(start), delay);
+  } else {
+    std::move(start).Run();
+  }
+}
+
+void GamepadPlatformDataFetcherOhos::ResetVibration(
+    int pad_index,
+    mojom::GamepadHapticsManager::ResetVibrationActuatorCallback callback,
+    scoped_refptr<base::SequencedTaskRunner> callback_runner) {
+  auto connection = haptic_connections_.find(pad_index);
+  if (connection == haptic_connections_.end()) {
+    GamepadDataFetcher::RunVibrationCallback(
+        std::move(callback), std::move(callback_runner),
+        mojom::GamepadHapticsResult::GamepadHapticsResultNotSupported);
+    return;
+  }
+
+  ++vibration_sequences_[pad_index];
+  WriteRumbleReport(
+      pad_index, 0, 0,
+      base::BindOnce(
+          [](mojom::GamepadHapticsManager::ResetVibrationActuatorCallback cb,
+             scoped_refptr<base::SequencedTaskRunner> runner, bool success) {
+            GamepadDataFetcher::RunVibrationCallback(
+                std::move(cb), std::move(runner),
+                success ? mojom::GamepadHapticsResult::GamepadHapticsResultComplete
+                        : mojom::GamepadHapticsResult::GamepadHapticsResultError);
+          },
+          std::move(callback), std::move(callback_runner)));
+}
+
+void GamepadPlatformDataFetcherOhos::DeviceAdded(
+    mojom::HidDeviceInfoPtr device_info) {
+  if (!device_info || device_info->vendor_id != 0x054c ||
+      (device_info->product_id != 0x0ce6 &&
+       device_info->product_id != 0x0df2) ||
+      device_info->bus_type != mojom::HidBusType::kHIDBusTypeUSB) {
+    return;
+  }
+
+  const std::string guid = device_info->guid;
+  dualsense_hid_devices_[guid] = std::move(device_info);
+  for (const auto& entry : devices_)
+    TryConnectHidDevice(entry.first);
+}
+
+void GamepadPlatformDataFetcherOhos::DeviceRemoved(
+    mojom::HidDeviceInfoPtr device_info) {
+  if (!device_info)
+    return;
+  const std::string guid = device_info->guid;
+  dualsense_hid_devices_.erase(guid);
+  for (auto it = gamepad_hid_guids_.begin(); it != gamepad_hid_guids_.end();) {
+    if (it->second == guid) {
+      haptic_connections_.erase(it->first);
+      vibration_sequences_.erase(it->first);
+      if (PadState* state = GetPadState(it->first))
+        state->data.vibration_actuator.not_null = false;
+      it = gamepad_hid_guids_.erase(it);
+    } else {
+      ++it;
+    }
+  }
+}
+
+void GamepadPlatformDataFetcherOhos::DeviceChanged(
+    mojom::HidDeviceInfoPtr) {}
+
+void GamepadPlatformDataFetcherOhos::OnHidDevicesEnumerated(
+    std::vector<mojom::HidDeviceInfoPtr> device_infos) {
+  for (auto& device_info : device_infos)
+    DeviceAdded(std::move(device_info));
+}
+
+void GamepadPlatformDataFetcherOhos::TryConnectHidDevice(int32_t gamepad_id) {
+  if (!hid_manager_ || haptic_connections_.contains(gamepad_id) ||
+      gamepad_hid_guids_.contains(gamepad_id)) {
+    return;
+  }
+  GamepadDeviceOhos* gamepad = GetDeviceWithDeviceId(gamepad_id);
+  if (!gamepad || gamepad->GetVendorId() != 0x054c ||
+      (gamepad->GetProductId() != 0x0ce6 &&
+       gamepad->GetProductId() != 0x0df2)) {
+    return;
+  }
+
+  for (const auto& [guid, info] : dualsense_hid_devices_) {
+    bool already_assigned = false;
+    for (const auto& assigned : gamepad_hid_guids_) {
+      if (assigned.second == guid) {
+        already_assigned = true;
+        break;
+      }
+    }
+    if (already_assigned || info->product_id != gamepad->GetProductId())
+      continue;
+
+    gamepad_hid_guids_[gamepad_id] = guid;
+    hid_manager_->Connect(
+        guid, mojo::NullRemote(), mojo::NullRemote(),
+        /*allow_protected_reports=*/false, /*allow_fido_reports=*/false,
+        base::BindOnce(&GamepadPlatformDataFetcherOhos::OnHidConnected,
+                       weak_factory_.GetWeakPtr(), gamepad_id, guid));
+    return;
+  }
+}
+
+void GamepadPlatformDataFetcherOhos::OnHidConnected(
+    int32_t gamepad_id,
+    const std::string& guid,
+    mojo::PendingRemote<mojom::HidConnection> connection) {
+  if (!connection) {
+    gamepad_hid_guids_.erase(gamepad_id);
+    return;
+  }
+  mojo::Remote<mojom::HidConnection> remote(std::move(connection));
+  remote.set_disconnect_handler(base::BindOnce(
+      [](base::WeakPtr<GamepadPlatformDataFetcherOhos> self,
+         int32_t id, std::string expected_guid) {
+        if (!self)
+          return;
+        auto found = self->gamepad_hid_guids_.find(id);
+        if (found != self->gamepad_hid_guids_.end() &&
+            found->second == expected_guid) {
+          self->gamepad_hid_guids_.erase(found);
+          self->haptic_connections_.erase(id);
+          if (PadState* state = self->GetPadState(id))
+            state->data.vibration_actuator.not_null = false;
+        }
+      }, weak_factory_.GetWeakPtr(), gamepad_id, guid));
+  haptic_connections_[gamepad_id] = std::move(remote);
+  if (PadState* state = GetPadState(gamepad_id))
+    state->data.vibration_actuator.not_null = true;
+}
+
+void GamepadPlatformDataFetcherOhos::StartRumbleEffect(
+    int32_t gamepad_id,
+    double strong_magnitude,
+    double weak_magnitude,
+    base::TimeDelta duration,
+    uint64_t vibration_sequence,
+    mojom::GamepadHapticsManager::PlayVibrationEffectOnceCallback callback,
+    scoped_refptr<base::SequencedTaskRunner> callback_runner) {
+  if (vibration_sequences_[gamepad_id] != vibration_sequence) {
+    GamepadDataFetcher::RunVibrationCallback(
+        std::move(callback), std::move(callback_runner),
+        mojom::GamepadHapticsResult::GamepadHapticsResultPreempted);
+    return;
+  }
+
+  WriteRumbleReport(
+      gamepad_id, strong_magnitude, weak_magnitude,
+      base::BindOnce(
+          [](base::WeakPtr<GamepadPlatformDataFetcherOhos> self,
+             int32_t id, base::TimeDelta duration, uint64_t sequence,
+             mojom::GamepadHapticsManager::PlayVibrationEffectOnceCallback cb,
+             scoped_refptr<base::SequencedTaskRunner> runner, bool success) {
+            if (success && self && duration.is_positive()) {
+              self->polling_task_runner_->PostDelayedTask(
+                  FROM_HERE,
+                  base::BindOnce(
+                      [](base::WeakPtr<GamepadPlatformDataFetcherOhos> owner,
+                         int32_t source_id, uint64_t expected_sequence) {
+                        if (owner && owner->vibration_sequences_[source_id] ==
+                                         expected_sequence) {
+                          owner->WriteRumbleReport(source_id, 0, 0);
+                        }
+                      },
+                      self, id, sequence),
+                  duration);
+            }
+            GamepadDataFetcher::RunVibrationCallback(
+                std::move(cb), std::move(runner),
+                success ? mojom::GamepadHapticsResult::GamepadHapticsResultComplete
+                        : mojom::GamepadHapticsResult::GamepadHapticsResultError);
+          },
+          weak_factory_.GetWeakPtr(), gamepad_id, duration,
+          vibration_sequence, std::move(callback),
+          std::move(callback_runner)));
+}
+
+void GamepadPlatformDataFetcherOhos::WriteRumbleReport(
+    int32_t gamepad_id,
+    double strong_magnitude,
+    double weak_magnitude,
+    base::OnceCallback<void(bool)> callback) {
+  auto connection = haptic_connections_.find(gamepad_id);
+  if (connection == haptic_connections_.end()) {
+    if (callback)
+      std::move(callback).Run(false);
+    return;
+  }
+
+  // DualSense USB report 0x02 uses the DualShock compatible rumble fields.
+  // The OHOS HID transport adds the USB-only 15-byte reserved trailer.
+  std::vector<uint8_t> report(47, 0);
+  // DualSense requires both HAPTICS_SELECT and COMPATIBLE_VIBRATION in
+  // valid_flag0 before it consumes the legacy left/right motor fields. This
+  // matches the upstream hid-playstation driver for controllers that use the
+  // original vibration mode.
+  report[0] = 0x03;
+  report[2] = base::ClampRound<uint8_t>(weak_magnitude * 255.0);
+  report[3] = base::ClampRound<uint8_t>(strong_magnitude * 255.0);
+  if (!callback)
+    callback = base::BindOnce([](bool) {});
+  connection->second->Write(0x02, report, std::move(callback));
+}
+
+GamepadDeviceOhos*
+GamepadPlatformDataFetcherOhos::GetDeviceWithDeviceId(int32_t device_id) {
+  DCHECK(polling_task_runner_->RunsTasksInCurrentSequence());
+  auto it = devices_.find(device_id);
+  if (it != devices_.end()) {
+    return it->second.get();
+  }
+  return nullptr;
+}
+
+GamepadDeviceOhos*
+GamepadPlatformDataFetcherOhos::GetOrCreateMatchingDevice(
+    int32_t device_id,
+    const std::string& name,
+    uint16_t vendor_id,
+    uint16_t product_id) {
+  DCHECK(polling_task_runner_->RunsTasksInCurrentSequence());
+  auto it = devices_.find(device_id);
+  if (it != devices_.end()) {
+    return it->second.get();
+  }
+  auto device = std::make_unique<GamepadDeviceOhos>(device_id, name,
+                                                     vendor_id, product_id);
+  GamepadDeviceOhos* result = device.get();
+  devices_[device_id] = std::move(device);
+  return result;
+}
+
+void GamepadPlatformDataFetcherOhos::RemoveDevice(int32_t device_id) {
+  DCHECK(polling_task_runner_->RunsTasksInCurrentSequence());
+  haptic_connections_.erase(device_id);
+  gamepad_hid_guids_.erase(device_id);
+  vibration_sequences_.erase(device_id);
+  auto it = devices_.find(device_id);
+  if (it != devices_.end()) {
+    it->second->Shutdown();
+    devices_.erase(it);
+  }
+}
+
+void GamepadPlatformDataFetcherOhos::OnDeviceConnected(
+    int32_t device_id,
+    const std::string& device_name,
+    uint16_t vendor_id,
+    uint16_t product_id) {
+  GamepadDeviceOhos* device = GetOrCreateMatchingDevice(device_id, device_name,
+                                                        vendor_id, product_id);
+  device->SetConnected(true);
+
+  PadState* state = GetPadState(device_id);
+  if (!state) {
+    return;
+  }
+
+  state->is_newly_active = true;
+  state->is_initialized = true;
+
+  state->mapper = device->GetMappingFunction();
+
+  Gamepad& pad = state->data;
+  GamepadDataFetcher::UpdateGamepadStrings(
+      device->GetName(), device->GetVendorId(), device->GetProductId(),
+      state->mapper != nullptr, pad);
+
+  pad.vibration_actuator.type = GamepadHapticActuatorType::kDualRumble;
+  pad.vibration_actuator.not_null = false;
+  pad.connected = true;
+
+  state->button_mask = ~0u;
+  state->axis_mask = ~0u;
+  TryConnectHidDevice(device_id);
+}
+
+void GamepadPlatformDataFetcherOhos::OnDeviceDisconnected(int32_t device_id) {
+  RemoveDevice(device_id);
+}
+
+void GamepadPlatformDataFetcherOhos::OnButtonEvent(int32_t device_id,
+                                                   int button_code,
+                                                   bool pressed) {
+  GamepadDeviceOhos* device = GetDeviceWithDeviceId(device_id);
+  if (!device) {
+    return;
+  }
+  device->UpdateButtonState(button_code, pressed, pressed ? 1.0f : 0.0f);
+}
+
+void GamepadPlatformDataFetcherOhos::OnAxisEvent(int32_t device_id,
+                                                 int axis_type,
+                                                 float x,
+                                                 float y) {
+  GamepadDeviceOhos* device = GetDeviceWithDeviceId(device_id);
+  if (!device) {
+    return;
+  }
+  device->UpdateAxisState(axis_type, x, y);
+}
