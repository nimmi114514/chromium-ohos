+      channel_layout_(CHANNEL_LAYOUT_NONE),
+      sample_rate_(0),
+      decoder_format_(std::make_shared<OhosAudioDecoderFormat>()),
+      task_runner_(task_runner),
+      pool_(base::MakeRefCounted<AudioBufferMemoryPool>()),
+      media_log_(std::move(media_log)) {
