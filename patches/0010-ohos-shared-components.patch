+// Read the exact report descriptor size from the interface's USB HID class
+// descriptor instead of truncating larger, valid vendor/game-controller
+// descriptors at an arbitrary fixed buffer size.
+std::optional<size_t> GetReportDescriptorSize(
+    const mojom::UsbAlternateInterfaceInfo& alternate) {
+  const auto& extra_data = alternate.extra_data;
+  for (size_t offset = 0; offset + 2 <= extra_data.size();) {
+    const size_t descriptor_length = extra_data[offset];
+    if (descriptor_length < 2 || descriptor_length > extra_data.size() - offset)
+      return std::nullopt;
+
+    // USB HID descriptor: bLength, bDescriptorType, bcdHID, bCountryCode,
+    // bNumDescriptors, followed by (type, length) entries.
+    if (extra_data[offset + 1] == 0x21 && descriptor_length >= 6) {
+      const size_t descriptor_count = extra_data[offset + 5];
+      if (descriptor_count > (descriptor_length - 6) / 3)
+        return std::nullopt;
+      for (size_t i = 0; i < descriptor_count; ++i) {
+        const size_t tuple = offset + 6 + i * 3;
+        if (extra_data[tuple] != 0x22)
+          continue;
+        const size_t report_size = extra_data[tuple + 1] |
+                                   (static_cast<size_t>(extra_data[tuple + 2]) << 8);
+        if (report_size)
+          return report_size;
+      }
+    }
+    offset += descriptor_length;
+  }
+  return std::nullopt;
+}
+
+bool FilterHidDevice(const USBDevice& device) {
+  bool eligible = false;
+  for (const auto& config : device.configs)
+    for (const auto& interface : config.interfaces)
+      if (interface.clazz == 3) eligible = true;
+  HID_LOG(EVENT) << "OHOS HID USB candidate: " << device.productName
+                 << " vid=" << device.vendorId << " pid=" << device.productId
+                 << " HID=" << eligible;
+  return eligible;
+}
+}  // namespace
+
+class HidServiceOhos::BlockingTaskRunnerHelper : public DeviceWatcher::Observer {
+ public:
+  BlockingTaskRunnerHelper(base::WeakPtr<HidServiceOhos> service,
+                          scoped_refptr<base::SequencedTaskRunner> task_runner)
+      : service_(std::move(service)), task_runner_(std::move(task_runner)) {
+    HID_LOG(EVENT) << "OHOS HID enumeration started";
+    watcher_ = DeviceWatcher::StartWatching(this, FilterHidDevice);
+    watcher_->EnumerateExistingDevices();
+    enumeration_started_ = true;
+    MaybeCompleteEnumeration();
+  }
+  ~BlockingTaskRunnerHelper() override {
+    weak_factory_.InvalidateWeakPtrs();
+    for (auto& [name, probe] : pending_) {
+      if (probe->handle) probe->handle->Close();
+    }
+  }
+
+ private:
+  struct Probe {
+    struct HidInterface {
+      uint8_t number;
+      size_t report_descriptor_size;
+    };
+    USBDevice physical;
+    scoped_refptr<UsbDeviceOhos> device;
+    scoped_refptr<UsbDeviceHandle> handle;
+    std::vector<HidInterface> interfaces;
+    size_t next = 0;
+  };
+  void OnDeviceAdded(const USBDevice& device) override {
+    if (device.name.empty() || known_.contains(device.name)) return;
+    known_.insert(device.name);
+    HID_LOG(EVENT) << "OHOS HID opening USB device: " << device.productName;
+    auto probe = std::make_shared<Probe>();
+    probe->physical = device;
+    probe->device = UsbDeviceOhos::CreateForHid(device);
+    pending_[device.name] = probe;
+    probe->device->Open(base::BindOnce(
+        [](base::WeakPtr<BlockingTaskRunnerHelper> helper,
+           std::shared_ptr<Probe> probe, scoped_refptr<UsbDeviceHandle> handle) {
+          if (!helper || !helper->IsCurrent(probe)) {
+            if (handle) handle->Close();
+            return;
+          }
+          helper->Opened(std::move(probe), std::move(handle));
+        }, weak_factory_.GetWeakPtr(), probe));
+  }
+  bool IsCurrent(const std::shared_ptr<Probe>& probe) const {
+    auto it = pending_.find(probe->physical.name);
+    return it != pending_.end() && it->second == probe;
+  }
+  void Opened(std::shared_ptr<Probe> probe,
+              scoped_refptr<UsbDeviceHandle> handle) {
+    if (!handle) {
+      HID_LOG(ERROR) << "OHOS HID USB authorization/open failed";
+      Finish(probe);
+      return;
+    }
+    probe->handle = std::move(handle);
+    const auto* config = probe->device->GetActiveConfiguration();
+    if (config) {
+      for (const auto& interface : config->interfaces) {
+        for (const auto& alternate : interface->alternates) {
+          HID_LOG(EVENT) << "OHOS HID USB interface="
+                         << static_cast<int>(interface->interface_number)
+                         << " class=" << static_cast<int>(alternate->class_code)
+                         << " subclass=" << static_cast<int>(alternate->subclass_code)
+                         << " alternate=" << static_cast<int>(alternate->alternate_setting);
+          if (alternate->alternate_setting == 0 &&
+              alternate->class_code == 3) {
+            const auto report_descriptor_size =
+                GetReportDescriptorSize(*alternate);
+            if (!report_descriptor_size) {
+              HID_LOG(ERROR) << "OHOS HID interface has no valid report "
+                                "descriptor length, interface="
+                             << static_cast<int>(interface->interface_number);
+              continue;
+            }
+            probe->interfaces.push_back(
+                {interface->interface_number, *report_descriptor_size});
+            break;
+          }
+        }
+      }
+    }
+    ReadDescriptor(probe);
+  }
+  void ReadDescriptor(std::shared_ptr<Probe> probe) {
+    if (probe->next == probe->interfaces.size()) {
+      Finish(probe);
+      return;
+    }
+    const auto interface = probe->interfaces[probe->next++];
+    // usbfs requires ownership even for an interface-recipient descriptor
+    // request. A HID kernel driver may already own this interface. Claim it,
+    // read its descriptor, then restore the driver immediately.
+    static_cast<UsbDeviceHandleUsbfs*>(probe->handle.get())
+        ->ClaimInterfaceForHid(interface.number, base::BindOnce(
+            &BlockingTaskRunnerHelper::DescriptorInterfaceClaimed,
+            weak_factory_.GetWeakPtr(), probe, interface.number));
+  }
+  void DescriptorInterfaceClaimed(std::shared_ptr<Probe> probe,
+                                  uint8_t interface, bool success) {
+    if (!IsCurrent(probe)) return;
+    if (!success) {
+      HID_LOG(ERROR) << "OHOS HID descriptor interface claim failed: "
+                     << static_cast<int>(interface);
+      ReadDescriptor(std::move(probe));
+      return;
+    }
+    probe->handle->ControlTransfer(
+        mojom::UsbTransferDirection::INBOUND,
+        mojom::UsbControlTransferType::STANDARD,
+        mojom::UsbControlTransferRecipient::INTERFACE,
+        /*GET_DESCRIPTOR=*/6, /*HID report descriptor=*/0x2200, interface,
+        base::MakeRefCounted<base::RefCountedBytes>(
+            probe->interfaces[probe->next - 1].report_descriptor_size), 1000,
+        base::BindOnce(&BlockingTaskRunnerHelper::DescriptorRead,
+                       weak_factory_.GetWeakPtr(), probe, interface));
+  }
+  void DescriptorRead(std::shared_ptr<Probe> probe, uint8_t interface,
+                      mojom::UsbTransferStatus status,
+                      scoped_refptr<base::RefCountedBytes> bytes, size_t length) {
+    if (!IsCurrent(probe)) return;
+    scoped_refptr<HidDeviceInfo> ready_info;
+    if (status == mojom::UsbTransferStatus::COMPLETED && length &&
+        length <= bytes->size()) {
+      const auto& physical = probe->physical;
+      const std::string id = physical.name + ":hid:" + std::to_string(interface);
+      auto info = base::MakeRefCounted<HidDeviceInfo>(
+          id, physical.name, static_cast<uint16_t>(physical.vendorId),
+          static_cast<uint16_t>(physical.productId), physical.productName,
+          physical.serial, mojom::HidBusType::kHIDBusTypeUSB,
+          base::span(bytes->as_vector()).first(length));
+      if (!info->collections().empty() &&
+          info->max_input_report_size() <= 65535 &&
+          info->max_output_report_size() <= 65535 &&
+          info->max_feature_report_size() <= 65535) {
+        ready_info = std::move(info);
+      }
+    } else {
+      HID_LOG(ERROR) << "OHOS HID report descriptor unavailable, interface="
+                   << static_cast<int>(interface)
+                   << " status=" << static_cast<int>(status);
+    }
+    HID_LOG(EVENT) << "OHOS HID descriptor read: interface="
+                   << static_cast<int>(interface) << " bytes=" << length
+                   << " status=" << static_cast<int>(status);
+    probe->handle->ReleaseInterface(interface, base::BindOnce(
+        &BlockingTaskRunnerHelper::DescriptorInterfaceReleased,
+        weak_factory_.GetWeakPtr(), probe, interface, std::move(ready_info)));
+  }
+  void DescriptorInterfaceReleased(std::shared_ptr<Probe> probe,
+                                    uint8_t interface,
+                                    scoped_refptr<HidDeviceInfo> info,
+                                    bool success) {
+    if (!IsCurrent(probe)) return;
+    if (!success) {
+      HID_LOG(ERROR) << "OHOS HID descriptor interface release failed";
+      Finish(probe);
+      return;
+    }
+    // Publish only after releasing the probe claim and restoring the driver.
+    // A page can immediately open a device as soon as it appears in a chooser.
+    if (info) {
+      task_runner_->PostTask(FROM_HERE,
+          base::BindOnce(&HidServiceOhos::AddInterface, service_, probe->physical,
+                         interface, std::move(info)));
+    }
+    ReadDescriptor(std::move(probe));
+  }
+  void Finish(const std::shared_ptr<Probe>& probe) {
+    if (probe->handle) {
+      probe->handle->Close();
+      probe->handle = nullptr;
+    }
+    pending_.erase(probe->physical.name);
+    MaybeCompleteEnumeration();
+  }
+  void MaybeCompleteEnumeration() {
+    if (enumeration_started_ && pending_.empty() && !enumeration_complete_) {
+      enumeration_complete_ = true;
+      HID_LOG(EVENT) << "OHOS HID initial enumeration complete";
+      task_runner_->PostTask(FROM_HERE,
+          base::BindOnce(&HidServiceOhos::FirstEnumerationComplete, service_));
+    }
+  }
+  void OnDeviceRemoved(const USBDevice& device) override {
+    known_.erase(device.name);
+    auto it = pending_.find(device.name);
+    if (it != pending_.end()) {
+      auto probe = it->second;
+      pending_.erase(it);
+      if (probe->handle) probe->handle->Close();
+      MaybeCompleteEnumeration();
+    }
+    task_runner_->PostTask(FROM_HERE,
+        base::BindOnce(&HidServiceOhos::RemovePhysicalDevice, service_, device.name));
+  }
+  void OnDeviceChanged(const USBDevice& device) override {
+    // DeviceWatcher reports a changed USB identity as remove + add. Keep this
+    // callback as a safety net for observers that report changes directly.
+    OnDeviceRemoved(device);
+    OnDeviceAdded(device);
+  }
+  std::unique_ptr<DeviceWatcher> watcher_;
+  base::WeakPtr<HidServiceOhos> service_;
+  scoped_refptr<base::SequencedTaskRunner> task_runner_;
+  std::set<std::string> known_;
+  std::map<std::string, std::shared_ptr<Probe>> pending_;
+  bool enumeration_started_ = false;
+  bool enumeration_complete_ = false;
+  base::WeakPtrFactory<BlockingTaskRunnerHelper> weak_factory_{this};
+};
+
+HidServiceOhos::HidServiceOhos() {
+  helper_ = base::SequenceBound<BlockingTaskRunnerHelper>(
+      base::ThreadPool::CreateSingleThreadTaskRunner(kBlockingTaskTraits),
+      weak_factory_.GetWeakPtr(), base::SequencedTaskRunner::GetCurrentDefault());
+}
+HidServiceOhos::~HidServiceOhos() = default;
+
+void HidServiceOhos::AddInterface(USBDevice physical, uint8_t interface,
+                                 scoped_refptr<HidDeviceInfo> info) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  const auto& id = info->platform_device_id_map().front().platform_device_id;
+  interfaces_[id] = InterfaceDevice{std::move(physical), interface};
+  HID_LOG(EVENT) << "OHOS HID registered interface="
+                 << static_cast<int>(interface)
+                 << " collections=" << info->collections().size();
+  AddDevice(std::move(info));
+}
+void HidServiceOhos::RemovePhysicalDevice(const std::string& name) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  for (auto it = interfaces_.begin(); it != interfaces_.end();) {
+    if (it->second.device.name == name) {
+      auto id = it->first;
+      it = interfaces_.erase(it);
+      RemoveDevice(id);
+    } else ++it;
+  }
+}
+void HidServiceOhos::Connect(const std::string& device_guid,
+                              bool allow_protected_reports,
+                              bool allow_fido_reports,
+                              ConnectCallback callback) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  auto found = devices().find(device_guid);
+  if (found == devices().end()) {
+    std::move(callback).Run(nullptr);
+    return;
+  }
+  auto info = found->second;
+  const auto& id = info->platform_device_id_map().front().platform_device_id;
+  auto entry = interfaces_.find(id);
+  if (entry == interfaces_.end()) {
+    std::move(callback).Run(nullptr);
+    return;
+  }
+  const auto interface = entry->second.interface_number;
+  auto usb = UsbDeviceOhos::CreateForHid(entry->second.device);
+  usb->Open(base::BindOnce(
+      [](base::WeakPtr<HidServiceOhos> service,
+         scoped_refptr<HidDeviceInfo> info, uint8_t interface,
+         bool allow_protected, bool allow_fido, ConnectCallback callback,
+         scoped_refptr<UsbDeviceHandle> handle) {
+        if (!service || !handle || !service->devices().contains(info->device_guid())) {
+          if (handle) handle->Close();
+          std::move(callback).Run(nullptr);
+          return;
+        }
+        // UsbDeviceOhos always creates the existing Chromium usbfs transport.
+        auto* usbfs = static_cast<UsbDeviceHandleUsbfs*>(handle.get());
+        usbfs->ClaimInterfaceForHid(interface, base::BindOnce(
+            [](base::WeakPtr<HidServiceOhos> service,
+               scoped_refptr<HidDeviceInfo> info,
+               scoped_refptr<UsbDeviceHandle> handle, uint8_t interface,
+               bool allow_protected, bool allow_fido, ConnectCallback callback,
+               bool success) {
+              if (!success || !service ||
+                  !service->devices().contains(info->device_guid())) {
+                handle->Close();
+                std::move(callback).Run(nullptr);
+                return;
+              }
+              std::move(callback).Run(base::MakeRefCounted<HidConnectionOhos>(
+                  info, handle, interface, allow_protected, allow_fido));
+            }, service, info, handle, interface, allow_protected, allow_fido,
+            std::move(callback)));
+      }, weak_factory_.GetWeakPtr(), info, interface, allow_protected_reports,
+      allow_fido_reports, std::move(callback)));
+}
+base::WeakPtr<HidService> HidServiceOhos::GetWeakPtr() {
+  return weak_factory_.GetWeakPtr();
+}
+}  // namespace device
