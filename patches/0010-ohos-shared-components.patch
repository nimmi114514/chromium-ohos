+  base::ScopedBlockingCall scoped_blocking_call(FROM_HERE,
+                                                base::BlockingType::MAY_BLOCK);
+  return base::WrapUnique(new DeviceWatcher(observer, filter));
+}
+
+DeviceWatcher::~DeviceWatcher() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (device_adapter_) {
+    device_adapter_->UnregisterHotplugCallback();
+  }
+}
+
+void DeviceWatcher::EnumerateExistingDevices() {
+  RefreshDevices();
+}
+
+void DeviceWatcher::RefreshDevices() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  base::ScopedBlockingCall scoped_blocking_call(FROM_HERE,
+                                                base::BlockingType::MAY_BLOCK);
+  std::vector<USBDevice> device_list;
+  if (!device_adapter_ || !device_adapter_->GetDevices(device_list)) {
+    LOG(WARNING) << "GetDevices Failed.";
+    return;
+  }
+  // On this OHOS build USBHostMgr returns an empty list to a regular app
+  // ("neither system app nor sa"), even when a device was delivered through
+  // the USB attach common event. Such a snapshot is not authoritative and
+  // must not erase devices learned from hotplug notifications.
+  if (device_list.empty() && !observed_devices_.empty()) {
+    LOG(WARNING) << "Ignoring empty OHOS USB snapshot; retaining hotplug state.";
+    return;
+  }
+
+  std::map<std::string, USBDevice> current;
+  for (const auto& device : device_list) {
+    if (device.name.empty() || (filter_ && !filter_(device))) continue;
+    current.insert_or_assign(device.name, device);
+  }
+  for (const auto& [name, old_device] : observed_devices_) {
+    auto it = current.find(name);
+    if (it == current.end() || !SameUsbDevice(old_device, it->second)) {
+      if (observer_) observer_->OnDeviceRemoved(old_device);
+    }
+  }
+  for (const auto& [name, device] : current) {
+    auto it = observed_devices_.find(name);
+    if (it == observed_devices_.end() || !SameUsbDevice(it->second, device)) {
+      if (observer_) observer_->OnDeviceAdded(device);
+    }
+  }
+  observed_devices_ = std::move(current);
+}
+
+DeviceWatcher::DeviceWatcher(Observer* observer, DeviceFilter filter)
+    : task_runner_(base::SequencedTaskRunner::GetCurrentDefault()),
+      observer_(observer), filter_(filter) {
+  event_target_ = weak_factory_.GetWeakPtr();
+  device_adapter_ = std::make_unique<DeviceAdapter>();
+  if (device_adapter_) {
+    device_adapter_->RegisterHotplugCallback(this);
+  }
+}
+
+void DeviceWatcher::OnDeviceAttatched(USBDevice& device) {
+  // USBManager events arrive on the ArkTS main thread. Observers and their
+  // device maps belong to the sequence which created this watcher.
+  task_runner_->PostTask(FROM_HERE,
+      base::BindOnce(&DeviceWatcher::NotifyAdded, event_target_, device));
+}
+void DeviceWatcher::OnDeviceRemoved(USBDevice& device) {
+  task_runner_->PostTask(FROM_HERE,
+      base::BindOnce(&DeviceWatcher::NotifyRemoved, event_target_, device));
+}
+void DeviceWatcher::NotifyAdded(USBDevice device) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!observer_ || device.name.empty() || (filter_ && !filter_(device))) return;
+  auto it = observed_devices_.find(device.name);
+  if (it != observed_devices_.end()) {
+    // OHOS can reuse the same USB name/address after unplug/replug and may
+    // lose the detach broadcast. A repeated attach must invalidate stale HID
+    // handles and start enumeration again.
+    observer_->OnDeviceRemoved(it->second);
+  }
+  observed_devices_.insert_or_assign(device.name, device);
+  observer_->OnDeviceAdded(device);
+}
+void DeviceWatcher::NotifyRemoved(USBDevice device) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  // Detach broadcasts may contain only the device name, without interfaces.
+  if (!observer_) return;
+  auto it = observed_devices_.find(device.name);
+  if (it != observed_devices_.end()) {
+    device = it->second;
+    observed_devices_.erase(it);
+  }
+  observer_->OnDeviceRemoved(device);
+}
+}  // namespace device
