diff --git a/services/device/hid/hid_connection_ohos.cc b/services/device/hid/hid_connection_ohos.cc
new file mode 100644
index 0000000000..54ebd09ca4
--- /dev/null
+++ b/services/device/hid/hid_connection_ohos.cc
@@ -0,0 +1,219 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license in LICENSE.
+#include "services/device/hid/hid_connection_ohos.h"
+
+#include "base/containers/span.h"
+#include "base/functional/bind.h"
+#include "base/memory/ref_counted_memory.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/time/time.h"
+#include "components/device_event_log/device_event_log.h"
+#include "services/device/usb/usb_device.h"
+
+namespace device {
+namespace {
+constexpr unsigned int kTransferTimeoutMs = 1000;
+constexpr uint8_t kGetReport = 1;
+constexpr uint8_t kSetReport = 9;
+constexpr uint8_t kOutputReport = 2;
+constexpr uint8_t kFeatureReport = 3;
+}  // namespace
+
+HidConnectionOhos::HidConnectionOhos(
+    scoped_refptr<HidDeviceInfo> info, scoped_refptr<UsbDeviceHandle> handle,
+    uint8_t interface_number, bool allow_protected_reports,
+    bool allow_fido_reports)
+    : HidConnection(std::move(info), allow_protected_reports, allow_fido_reports),
+      handle_(std::move(handle)), interface_number_(interface_number),
+      alive_(base::MakeRefCounted<base::RefCountedData<bool>>(true)) {
+  const auto* config = handle_->GetDevice()->GetActiveConfiguration();
+  if (config) {
+    for (const auto& interface : config->interfaces) {
+      if (interface->interface_number != interface_number_) continue;
+      for (const auto& alternate : interface->alternates) {
+        if (alternate->alternate_setting != 0) continue;
+        for (const auto& endpoint : alternate->endpoints) {
+          if (endpoint->type != mojom::UsbTransferType::INTERRUPT) continue;
+          if (endpoint->direction == mojom::UsbTransferDirection::INBOUND)
+            in_endpoint_ = endpoint->endpoint_number;
+          else
+            out_endpoint_ = endpoint->endpoint_number;
+        }
+      }
+    }
+  }
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&HidConnectionOhos::ReadNext,
+                               weak_factory_.GetWeakPtr()));
+}
+
+HidConnectionOhos::~HidConnectionOhos() = default;
+
+void HidConnectionOhos::PlatformClose() {
+  alive_->data = false;
+  weak_factory_.InvalidateWeakPtrs();
+  if (handle_) {
+    handle_->Close();
+    handle_ = nullptr;
+  }
+}
+
+void HidConnectionOhos::ReadNext() {
+  if (!handle_ || !in_endpoint_ || !device_info()->max_input_report_size()) return;
+  size_t size = device_info()->max_input_report_size() +
+                (device_info()->has_report_id() ? 1 : 0);
+  handle_->GenericTransfer(
+      mojom::UsbTransferDirection::INBOUND, in_endpoint_,
+      base::MakeRefCounted<base::RefCountedBytes>(size), kTransferTimeoutMs,
+      base::BindOnce(&HidConnectionOhos::OnRead, weak_factory_.GetWeakPtr()));
+}
+
+void HidConnectionOhos::OnRead(mojom::UsbTransferStatus status,
+                              scoped_refptr<base::RefCountedBytes> buffer,
+                              size_t size) {
+  if (!handle_) return;
+  if (status == mojom::UsbTransferStatus::COMPLETED && size &&
+      size <= buffer->size()) {
+    if (!device_info()->has_report_id()) {
+      auto framed = base::MakeRefCounted<base::RefCountedBytes>(size + 1);
+      framed->as_vector()[0] = 0;
+      base::span(framed->as_vector()).subspan(1u).copy_from(
+          base::span(buffer->as_vector()).first(size));
+      buffer = std::move(framed);
+      ++size;
+    }
+    ProcessInputReport(std::move(buffer), size);
+  } else if (status != mojom::UsbTransferStatus::TIMEOUT &&
+             status != mojom::UsbTransferStatus::COMPLETED) {
+    HID_LOG(EVENT) << "OHOS HID input stopped: " << static_cast<int>(status);
+    return;
+  }
+  base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE, base::BindOnce(&HidConnectionOhos::ReadNext,
+                               weak_factory_.GetWeakPtr()), base::Milliseconds(1));
+}
+
+void HidConnectionOhos::SendReport(
+    uint8_t type, scoped_refptr<base::RefCountedBytes> framed,
+    WriteCallback callback) {
+  if (!handle_ || !framed->size()) {
+    std::move(callback).Run(false);
+    return;
+  }
+  const uint8_t id = framed->as_vector()[0];
+  if (!device_info()->has_report_id() && id != 0) {
+    std::move(callback).Run(false);
+    return;
+  }
+  auto payload = base::MakeRefCounted<base::RefCountedBytes>();
+  const auto bytes = base::span(framed->as_vector()).subspan(
+      device_info()->has_report_id() ? 0u : 1u);
+  payload->as_vector().assign(bytes.begin(), bytes.end());
+  // DualSense USB output report 0x02 is described as 47 payload bytes, but
+  // the controller's USB transport expects the 63-byte packet used by the
+  // Linux hid-playstation driver (report ID + 47 common bytes + 15 reserved
+  // bytes). Other HID devices must retain the exact report length from their
+  // descriptor.
+  constexpr uint16_t kSonyVendorId = 0x054c;
+  constexpr uint16_t kDualSenseProductId = 0x0ce6;
+  constexpr size_t kDualSenseUsbOutputReportSize = 63;
+  if (type == kOutputReport && device_info()->vendor_id() == kSonyVendorId &&
+      device_info()->product_id() == kDualSenseProductId && id == 0x02 &&
+      payload->size() < kDualSenseUsbOutputReportSize) {
+    payload->as_vector().resize(kDualSenseUsbOutputReportSize, 0);
+  }
+  const size_t transfer_size = payload->size();
+  HID_LOG(EVENT) << "OHOS HID output: vid=" << device_info()->vendor_id()
+                 << " pid=" << device_info()->product_id()
+                 << " interface=" << static_cast<int>(interface_number_)
+                 << " report=" << static_cast<int>(id)
+                 << " type=" << static_cast<int>(type)
+                 << " bytes=" << transfer_size
+                 << " endpoint=" << static_cast<int>(out_endpoint_);
+  if (type == kOutputReport && device_info()->vendor_id() == kSonyVendorId &&
+      device_info()->product_id() == kDualSenseProductId &&
+      payload->size() >= kDualSenseUsbOutputReportSize) {
+    // The DualSense USB output report starts with report ID 0x02, followed by
+    // valid_flag0, valid_flag1, right/left rumble, ... valid_flag2 at byte 39.
+    // Capture the protocol control fields so a successful USB transfer can be
+    // distinguished from a report that never enabled the motors.
+    const auto& report = payload->as_vector();
+    HID_LOG(EVENT) << "OHOS DualSense USB output fields: valid0="
+                   << static_cast<int>(report[1]) << " valid1="
+                   << static_cast<int>(report[2]) << " motor_right="
+                   << static_cast<int>(report[3]) << " motor_left="
+                   << static_cast<int>(report[4]) << " valid2="
+                   << static_cast<int>(report[39]);
+  }
+  auto complete = base::BindOnce(
+      [](scoped_refptr<base::RefCountedData<bool>> alive, size_t expected,
+         uint16_t vendor_id, uint16_t product_id, uint8_t report_id,
+         WriteCallback callback, mojom::UsbTransferStatus status,
+         scoped_refptr<base::RefCountedBytes>, size_t size) {
+        HID_LOG(EVENT) << "OHOS HID output completed: vid=" << vendor_id
+                       << " pid=" << product_id
+                       << " report=" << static_cast<int>(report_id)
+                       << " status=" << static_cast<int>(status)
+                       << " bytes=" << size << " expected=" << expected;
+        std::move(callback).Run(alive->data &&
+            status == mojom::UsbTransferStatus::COMPLETED && size == expected);
+      }, alive_, transfer_size, device_info()->vendor_id(),
+      device_info()->product_id(), id, std::move(callback));
+  if (type == kOutputReport && out_endpoint_) {
+    handle_->GenericTransfer(mojom::UsbTransferDirection::OUTBOUND,
+                             out_endpoint_, payload, kTransferTimeoutMs,
+                             std::move(complete));
+  } else {
+    handle_->ControlTransfer(
+        mojom::UsbTransferDirection::OUTBOUND,
+        mojom::UsbControlTransferType::CLASS,
+        mojom::UsbControlTransferRecipient::INTERFACE, kSetReport,
+        (static_cast<uint16_t>(type) << 8) | id, interface_number_, payload,
+        kTransferTimeoutMs, std::move(complete));
+  }
+}
+
+void HidConnectionOhos::PlatformWrite(
+    scoped_refptr<base::RefCountedBytes> buffer, WriteCallback callback) {
+  SendReport(kOutputReport, std::move(buffer), std::move(callback));
+}
+void HidConnectionOhos::PlatformSendFeatureReport(
+    scoped_refptr<base::RefCountedBytes> buffer, WriteCallback callback) {
+  SendReport(kFeatureReport, std::move(buffer), std::move(callback));
+}
+void HidConnectionOhos::PlatformGetFeatureReport(
+    uint8_t report_id, ReadCallback callback) {
+  if (!handle_) {
+    std::move(callback).Run(false, nullptr, 0);
+    return;
+  }
+  const bool has_id = device_info()->has_report_id();
+  auto buffer = base::MakeRefCounted<base::RefCountedBytes>(
+      device_info()->max_feature_report_size() + (has_id ? 1 : 0));
+  handle_->ControlTransfer(
+      mojom::UsbTransferDirection::INBOUND,
+      mojom::UsbControlTransferType::CLASS,
+      mojom::UsbControlTransferRecipient::INTERFACE, kGetReport,
+      (static_cast<uint16_t>(kFeatureReport) << 8) | report_id,
+      interface_number_, buffer, kTransferTimeoutMs,
+      base::BindOnce(
+          [](scoped_refptr<base::RefCountedData<bool>> alive, bool has_id,
+             ReadCallback callback, mojom::UsbTransferStatus status,
+             scoped_refptr<base::RefCountedBytes> bytes, size_t size) {
+            if (!alive->data || status != mojom::UsbTransferStatus::COMPLETED ||
+                !size || size > bytes->size()) {
+              std::move(callback).Run(false, nullptr, 0);
+              return;
+            }
+            if (!has_id) {
+              auto framed = base::MakeRefCounted<base::RefCountedBytes>(size + 1);
+              framed->as_vector()[0] = 0;
+              base::span(framed->as_vector()).subspan(1u).copy_from(
+                  base::span(bytes->as_vector()).first(size));
+              bytes = std::move(framed);
+              ++size;
+            }
+            std::move(callback).Run(true, std::move(bytes), size);
+          }, alive_, has_id, std::move(callback)));
+}
+}  // namespace device
