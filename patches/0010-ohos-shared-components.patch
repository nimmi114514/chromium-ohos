+void MediaCodecDecoderBridgeImpl::PopInqueueDec() {
+  if (signal_ == nullptr || signal_->is_on_error_ ||
+      signal_->input_queue_.empty()) {
+    LOG(ERROR) << __func__ << "[VideoDecoder] signal_ is not available.";
+    return;
+  }
