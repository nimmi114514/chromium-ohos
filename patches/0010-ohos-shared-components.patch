new file mode 100644
index 0000000000..d6b775757a
--- /dev/null
+++ b/services/device/hid/ohos_tests/hid_transport_tests.cc
@@ -0,0 +1,196 @@
+// Copyright 2026 The Chromium Authors. BSD-style license in LICENSE.
+#include <cstdio>
+#include <utility>
+#include <vector>
+#include "base/check.h"
+#include "base/command_line.h"
+#include "base/feature_list.h"
+#include "base/functional/bind.h"
+#include "base/memory/ref_counted_memory.h"
+#include "base/run_loop.h"
+#include "base/task/single_thread_task_executor.h"
+#include "services/device/hid/hid_connection_ohos.h"
+#include "services/device/usb/usb_device.h"
+
+namespace device {
+using Bytes = base::RefCountedBytes;
+using Status = mojom::UsbTransferStatus;
+class TestDevice : public UsbDevice {
+ public:
+  explicit TestDevice(bool interrupt_out) : UsbDevice(Info(interrupt_out)) {}
+  void Open(OpenCallback callback) override { std::move(callback).Run(nullptr); }
+ private:
+  ~TestDevice() override = default;
+  static mojom::UsbDeviceInfoPtr Info(bool interrupt_out) {
+    auto info = mojom::UsbDeviceInfo::New();
+    info->active_configuration = 1;
+    auto config = mojom::UsbConfigurationInfo::New();
+    config->configuration_value = 1;
+    auto interface = mojom::UsbInterfaceInfo::New();
+    interface->interface_number = 2;
+    auto alternate = mojom::UsbAlternateInterfaceInfo::New();
+    alternate->class_code = 3;
+    auto input = mojom::UsbEndpointInfo::New();
+    input->type = mojom::UsbTransferType::INTERRUPT;
+    input->direction = mojom::UsbTransferDirection::INBOUND;
+    input->endpoint_number = 1;
+    alternate->endpoints.push_back(std::move(input));
+    if (interrupt_out) {
+      auto output = mojom::UsbEndpointInfo::New();
+      output->type = mojom::UsbTransferType::INTERRUPT;
+      output->direction = mojom::UsbTransferDirection::OUTBOUND;
+      output->endpoint_number = 2;
+      alternate->endpoints.push_back(std::move(output));
+    }
+    interface->alternates.push_back(std::move(alternate));
+    config->interfaces.push_back(std::move(interface));
+    info->configurations.push_back(std::move(config));
+    return info;
+  }
+};
+class TestHandle : public UsbDeviceHandle {
+ public:
+  explicit TestHandle(bool interrupt_out)
+      : device(base::MakeRefCounted<TestDevice>(interrupt_out)) {}
+  scoped_refptr<UsbDevice> GetDevice() const override { return device; }
+  void Close() override {
+    device = nullptr;
+    if (input) std::move(input).Run(Status::CANCELLED, nullptr, 0);
+    if (write) std::move(write).Run(Status::CANCELLED, nullptr, 0);
+  }
+  void SetConfiguration(int, ResultCallback cb) override { std::move(cb).Run(false); }
+  void ClaimInterface(int, ResultCallback cb) override { std::move(cb).Run(true); }
+  void ReleaseInterface(int, ResultCallback cb) override { std::move(cb).Run(true); }
+  void SetInterfaceAlternateSetting(int, int, ResultCallback cb) override { std::move(cb).Run(false); }
+  void ResetDevice(ResultCallback cb) override { std::move(cb).Run(false); }
+  void ClearHalt(mojom::UsbTransferDirection, uint8_t, ResultCallback cb) override { std::move(cb).Run(false); }
+  void IsochronousTransferIn(uint8_t, const std::vector<uint32_t>&, unsigned int,
+                            IsochronousTransferCallback) override { CHECK(false); }
+  void IsochronousTransferOut(uint8_t, scoped_refptr<Bytes>, const std::vector<uint32_t>&,
+                             unsigned int, IsochronousTransferCallback) override { CHECK(false); }
+  const mojom::UsbInterfaceInfo* FindInterfaceByEndpoint(uint8_t) override { return nullptr; }
+  void GenericTransfer(mojom::UsbTransferDirection direction, uint8_t endpoint,
+                       scoped_refptr<Bytes> buffer, unsigned int,
+                       TransferCallback cb) override {
+    if (direction == mojom::UsbTransferDirection::INBOUND) {
+      CHECK_EQ(endpoint, 1); input = std::move(cb);
+    } else {
+      CHECK_EQ(endpoint, 2); Output(buffer, std::move(cb));
+    }
+  }
+  void ControlTransfer(mojom::UsbTransferDirection direction,
+                       mojom::UsbControlTransferType type,
+                       mojom::UsbControlTransferRecipient recipient,
+                       uint8_t request, uint16_t value, uint16_t index,
+                       scoped_refptr<Bytes> buffer, unsigned int,
+                       TransferCallback cb) override {
+    CHECK(type == mojom::UsbControlTransferType::CLASS);
+    CHECK(recipient == mojom::UsbControlTransferRecipient::INTERFACE);
+    CHECK_EQ(index, 2); last_value = value;
+    if (direction == mojom::UsbTransferDirection::INBOUND) {
+      CHECK_EQ(request, 1);
+      buffer->as_vector() = feature;
+      std::move(cb).Run(Status::COMPLETED, buffer, feature.size());
+    } else {
+      CHECK_EQ(request, 9); Output(buffer, std::move(cb));
+    }
+  }
+  void Output(scoped_refptr<Bytes> buffer, TransferCallback cb) {
+    ++writes; last = buffer->as_vector();
+    if (delay_write) write = std::move(cb);
+    else std::move(cb).Run(Status::COMPLETED, buffer, buffer->size());
+  }
+  void Emit(std::vector<uint8_t> bytes) {
+    CHECK(input); auto buffer = base::MakeRefCounted<Bytes>();
+    buffer->as_vector() = std::move(bytes);
+    std::move(input).Run(Status::COMPLETED, buffer, buffer->size());
+  }
+  scoped_refptr<UsbDevice> device;
+  TransferCallback input, write;
+  std::vector<uint8_t> last, feature;
+  int writes = 0;
+  int last_value = 0;
+  bool delay_write = false;
+ private:
+  ~TestHandle() override = default;
+};
+scoped_refptr<HidDeviceInfo> MakeInfo(uint8_t id, bool protected_keyboard = false) {
+  std::vector<uint8_t> descriptor = {
+    0x06,0x00,0xff, 0x09,0x01, 0xa1,0x01,
+    0x75,0x08, 0x95,0x04, 0x09,0x01,0x81,0x02,
+    0x09,0x02,0x91,0x02,0x09,0x03,0xb1,0x02,0xc0};
+  if (protected_keyboard) { descriptor[1] = 1; descriptor[2] = 0; descriptor[4] = 6; }
+  if (id) descriptor.insert(descriptor.begin() + 7, {0x85,id});
+  return base::MakeRefCounted<HidDeviceInfo>("test-interface", "test-device",
+      0x1234,0x5678,"Synthetic generic HID","",mojom::HidBusType::kHIDBusTypeUSB,
+      descriptor);
+}
+scoped_refptr<Bytes> Framed(uint8_t id) {
+  auto buffer = base::MakeRefCounted<Bytes>();
+  buffer->as_vector() = {id,11,22,33,44}; return buffer;
+}
+void CheckWrite(bool* called, bool expected, bool ok) {
+  CHECK_EQ(ok, expected);
+  *called = true;
+}
+void CheckRead(bool* called, std::vector<uint8_t> expected, bool ok,
+               scoped_refptr<Bytes> bytes, size_t size) {
+  CHECK(ok);
+  CHECK_EQ(size, expected.size());
+  CHECK(bytes->as_vector() == expected);
+  *called = true;
+}
+void RunCase(uint8_t id, bool interrupt_out) {
+  auto info = MakeInfo(id); CHECK_EQ(info->max_input_report_size(), 4u);
+  CHECK_EQ(info->max_feature_report_size(), 4u);
+  auto handle = base::MakeRefCounted<TestHandle>(interrupt_out);
+  auto connection = base::MakeRefCounted<HidConnectionOhos>(info,handle,2,false,false);
+  base::RunLoop().RunUntilIdle();
+  const auto framed = Framed(id)->as_vector();
+  std::vector<uint8_t> wire = framed;
+  if (!id) wire.erase(wire.begin());
+  bool input = false;
+  connection->Read(base::BindOnce(&CheckRead, &input, framed));
+  handle->Emit(wire); CHECK(input);
+  bool output = false;
+  connection->Write(Framed(id),base::BindOnce(&CheckWrite, &output, true));
+  CHECK(output); CHECK(handle->last == wire);
+  if (!interrupt_out) CHECK_EQ(handle->last_value, 0x0200 | id);
+  handle->feature = wire;
+  bool feature_read = false;
+  connection->GetFeatureReport(id,base::BindOnce(&CheckRead, &feature_read, framed));
+  CHECK(feature_read); CHECK_EQ(handle->last_value, 0x0300 | id);
+  bool feature_write = false;
+  connection->SendFeatureReport(Framed(id),base::BindOnce(&CheckWrite, &feature_write, true));
+  CHECK(feature_write);CHECK(handle->last==wire);CHECK_EQ(handle->last_value,0x0300|id);
+  bool invalid = false;
+  auto bad = Framed(id ? 0 : 7);
+  connection->Write(bad,base::BindOnce(&CheckWrite, &invalid, false));CHECK(invalid);
+  bool oversized = false;
+  auto large = Framed(id);large->as_vector().push_back(99);
+  connection->Write(large,base::BindOnce(&CheckWrite, &oversized, false));CHECK(oversized);
+  handle->delay_write = true;
+  bool cancelled = false;
+  connection->Write(Framed(id),base::BindOnce(&CheckWrite, &cancelled, false));
+  connection->Close(); CHECK(cancelled); CHECK(!handle->device);
+  std::printf("PASS generic HID: reportId=%u interruptOut=%d\n",id,interrupt_out);
+}
+void ProtectedCase() {
+  auto handle=base::MakeRefCounted<TestHandle>(true);
+  auto connection=base::MakeRefCounted<HidConnectionOhos>(MakeInfo(0,true),handle,2,false,false);
+  bool rejected=false;
+  connection->Write(Framed(0),base::BindOnce(&CheckWrite, &rejected, false));
+  CHECK(rejected);CHECK_EQ(handle->writes,0);connection->Close();
+  base::RunLoop().RunUntilIdle();
+  std::puts("PASS protected keyboard reports remain blocked");
+}
+}  // namespace device
+int main(int argc, char** argv) {
+  base::CommandLine::Init(argc,argv);
+  base::FeatureList::InitInstance("","");
+  base::SingleThreadTaskExecutor executor;
+  for (uint8_t id : {0,7}) for (bool interrupt_out : {false,true})
+    device::RunCase(id,interrupt_out);
+  device::ProtectedCase();
+  std::puts("PASS all OHOS HID transport host regressions");
+}
