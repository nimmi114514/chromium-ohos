+  void RemoveDevice(int32_t device_id);
+  void OnHidDevicesEnumerated(
+      std::vector<mojom::HidDeviceInfoPtr> device_infos);
+  void TryConnectHidDevice(int32_t gamepad_id);
+  void OnHidConnected(int32_t gamepad_id,
+                      const std::string& guid,
+                      mojo::PendingRemote<mojom::HidConnection> connection);
+  void StartRumbleEffect(
