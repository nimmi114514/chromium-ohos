+enum class SeccompSandboxStatus {
+  NOT_SUPPORTED = 0,  // Seccomp is not supported.
+  DETECTION_FAILED,   // Run-time detection of SeccompTSYNC failed.
+  ENGAGED             // Sandbox was enabled and successfully turned on.
+};
