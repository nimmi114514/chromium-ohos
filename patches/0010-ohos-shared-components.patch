+#include "net/base/network_interfaces.h"
+
+namespace device_signals {
+
+std::string GetHostName() {
+  return net::GetHostName();
+}
+
+std::vector<std::string> GetSystemDnsServers() {
+  NetConn_NetHandle network{};
+  NetConn_ConnectionProperties properties{};
+  if (OH_NetConn_GetDefaultNet(&network) != 0 ||
+      OH_NetConn_GetConnectionProperties(&network, &properties) != 0) {
+    return {};
+  }
+
+  const auto dns_list = base::span(properties.dnsList);
+  if (properties.dnsListSize < 0 ||
+      static_cast<size_t>(properties.dnsListSize) > dns_list.size()) {
+    return {};
+  }
+
+  std::vector<std::string> servers;
+  for (const auto& dns :
+       dns_list.first(static_cast<size_t>(properties.dnsListSize))) {
+    const auto text = base::span(dns.address);
+    const auto end = std::ranges::find(text, '\0');
+    if (end == text.end()) {
+      return {};
+    }
+    net::IPAddress address;
+    if (!address.AssignFromIPLiteral(
+            base::as_string_view(
+                text.first(static_cast<size_t>(end - text.begin())))) ||
+        address.IsZero()) {
+      return {};
+    }
+    servers.push_back(net::IPEndPoint(address, 53).ToString());
+  }
+  return servers;
+}
+
+SettingValue GetOSFirewall() {
+  // This backend does not query OHOS firewall policy. A Linux UFW configuration
+  // cannot determine the state of the system firewall on OHOS.
+  return SettingValue::UNKNOWN;
+}
+
+}  // namespace device_signals
