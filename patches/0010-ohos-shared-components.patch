+void BluetoothClassicDeviceOhos::SetPinCode(const std::string& pincode) {
+  BluetoothOhos::SetDevicePinCode(device_id_, pincode, [](bool is_succeed) {
+    if (!is_succeed) {
+      LOG(ERROR) << "set device pin code failed.";
+    }
+  });
