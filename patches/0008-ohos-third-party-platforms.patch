 void MainThreadDebugger::DidClearContextsForFrame(LocalFrame* frame) {
   DCHECK(IsMainThread());
+#if BUILDFLAG(IS_OHOS)
+  if (frame->LocalFrameRoot() != frame) {
+    return;
+  }
+  // SVG image frames can be torn down during allocation-time sweeping. There
+  // is no context group to reset unless one was registered earlier; creating
+  // an identifier here can allocate and reenter the weak map through another
+  // SVG finalizer while its two indexes are being updated.
+  const int context_group_id =
+      WeakIdentifierMap<LocalFrame>::ExistingIdentifier(frame);
+  if (context_group_id) {
+    GetV8Inspector()->resetContextGroup(context_group_id);
+  }
+#else
   if (frame->LocalFrameRoot() == frame)
     GetV8Inspector()->resetContextGroup(ContextGroupId(frame));
+#endif
 }
 
 void MainThreadDebugger::ContextCreated(ScriptState* script_state,
