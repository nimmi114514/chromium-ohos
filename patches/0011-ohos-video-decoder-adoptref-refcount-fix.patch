   auto texture = CreateTexture(context_state.get());
-  return new NativeImageTextureGlOwner(std::move(texture),
-                                       std::move(context_state));
+  // Same reason as CodecSurfaceBundle above: NativeImageTextureOwner is a
+  // base::RefCountedDeleteOnSequence (refcount starts at 1), so the returned
+  // scoped_refptr must adopt the initial reference. Otherwise the owner is
+  // never destroyed, its GL texture is never deleted, and the driver keeps the
+  // dma-buf of the last bound EGLImage alive after every playback.
+  return base::AdoptRef(new NativeImageTextureGlOwner(std::move(texture),
+                                                     std::move(context_state)));
 }
 
