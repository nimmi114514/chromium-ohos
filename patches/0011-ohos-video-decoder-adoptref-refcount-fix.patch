diff --git a/media/gpu/ohos/ohos_video_decoder.cc b/media/gpu/ohos/ohos_video_decoder.cc
index ad67005107..4a2c37f3bd 100644
--- a/media/gpu/ohos/ohos_video_decoder.cc
+++ b/media/gpu/ohos/ohos_video_decoder.cc
@@ -318,8 +318,14 @@ void OhosVideoDecoder::OnVideoFrameFactoryInitialized(
     EnterTerminalState(State::kError, "Could not allocated TextureOwner");
     return;
   }
-  texture_owner_bundle_ =
-      new CodecSurfaceBundle(std::move(texture_owner), GetDrDcLock());
+  // CodecSurfaceBundle derives from base::RefCountedDeleteOnSequence, whose
+  // reference count starts at 1 (StartRefCountFromOneTag). The first scoped_refptr
+  // must therefore be created with base::AdoptRef(); assigning a raw new to a
+  // scoped_refptr adds a second reference that is never released, so the bundle
+  // would never be destroyed and neither would the OH_NativeImage owned by its
+  // texture owner.
+  texture_owner_bundle_ = base::AdoptRef(
+      new CodecSurfaceBundle(std::move(texture_owner), GetDrDcLock()));
 
   OnSurfaceChosen();
 }
diff --git a/gpu/command_buffer/service/ohos/native_image_texture_owner.cc b/gpu/command_buffer/service/ohos/native_image_texture_owner.cc
