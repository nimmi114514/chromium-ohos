diff --git a/build/config/ohos/BUILD.gn b/build/config/ohos/BUILD.gn
new file mode 100644
index 0000000000..eee01c1a14
--- /dev/null
+++ b/build/config/ohos/BUILD.gn
@@ -0,0 +1,40 @@
+import("//build/config/ohos/config.gni")
+
+assert(current_os == "ohos")
+
+config("compiler") {
+  cflags = [
+    "--target=$ohos_target_triple",
+    "--sysroot=" + rebase_path(ohos_sysroot, root_build_dir),
+    "-ffunction-sections",
+    "-fdata-sections",
+    "-pthread",
+  ]
+  if (ohos_clang_resource_dir != "") {
+    cflags += [ "-resource-dir=" +
+                rebase_path(ohos_clang_resource_dir, root_build_dir) ]
+  }
+  asmflags = cflags
+  defines = [
+    "OSOHOS",
+    "__MUSL__",
+  ]
+}
+
+config("runtime_library") {
+  ldflags = [
+    "--target=$ohos_target_triple",
+    "--sysroot=" + rebase_path(ohos_sysroot, root_build_dir),
+    "-L" + rebase_path("$ohos_sdk_native/llvm/lib/$ohos_target_triple",
+                       root_build_dir),
+    "-Wl,-z,defs",
+    "-Wl,-z,max-page-size=4096",
+  ]
+  if (ohos_clang_resource_dir != "") {
+    ldflags += [
+      "-resource-dir=" + rebase_path(ohos_clang_resource_dir, root_build_dir),
+      "-B" + rebase_path("$ohos_clang_resource_dir/lib/$ohos_target_triple",
+                         root_build_dir),
+    ]
+  }
+}
diff --git a/build/config/ohos/config.gni b/build/config/ohos/config.gni
new file mode 100644
index 0000000000..46320e411e
--- /dev/null
+++ b/build/config/ohos/config.gni
@@ -0,0 +1,30 @@
+# OHOS arm64 bring-up for Chromium 158.
+# Platform layout follows OpenHarmony-TPC's pc_chromium_132 port.
+
+declare_args() {
+  # Native SDK directory containing sysroot/ and llvm/.
+  ohos_sdk_native = "//ohos_sdk/openharmony/native"
+
+  # Keep Chromium's compiler by default. The old SDK compiler has not been
+  # validated against Chromium 158's language and compiler requirements.
+  ohos_clang_root = "//third_party/llvm-build/Release+Asserts"
+
+  # Optional resource overlay: current Clang builtin headers plus OHOS SDK
+  # compiler-rt/startup objects. Created by scripts/prepare_toolchain.py.
+  ohos_clang_resource_dir = ""
+
+  # Adapter entry point loaded by the HAP.
+  ohos_build_target = "chromium"
+  isolated_level = 0
+  enable_ohos_bytrace = true
+  product_name = "all"
+  gpu_switch = "on"
+  ohos_enable_media_router = false
+}
+
+ohos_sysroot = "$ohos_sdk_native/sysroot"
+ohos_target_triple = "aarch64-linux-ohos"
+
+if (current_os == "ohos") {
+  assert(current_cpu == "arm64", "Initial OHOS port supports arm64 only.")
+}
