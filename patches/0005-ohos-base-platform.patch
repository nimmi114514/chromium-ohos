+#ifndef BASE_TRACE_EVENT_OHOS_HITRACE_INTERCEPTOR_H_
+#define BASE_TRACE_EVENT_OHOS_HITRACE_INTERCEPTOR_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <string_view>
+
+#include "absl/container/flat_hash_map.h"
