+// The import follows Dawn's Android native-buffer service and Huawei's
+// VK_OHOS_external_memory API, with the actual NativeBuffer memory type selected
+// from the intersection of driver buffer properties and image requirements.
+#include "src/dawn/native/vulkan/external_memory/MemoryServiceImplementationOHOSNativeBuffer.h"
+
+#include "src/dawn/native/vulkan/DeviceVk.h"
+#include "src/dawn/native/vulkan/PhysicalDeviceVk.h"
+#include "src/dawn/native/vulkan/TextureVk.h"
+#include "src/dawn/native/vulkan/UtilsVulkan.h"
+#include "src/dawn/native/vulkan/VulkanError.h"
+#include "src/dawn/native/vulkan/external_memory/MemoryServiceImplementation.h"
+
+// Platform extension declarations require the Vulkan types above.
+#include <vulkan/vulkan_ohos.h>
+
+namespace dawn::native::vulkan::external_memory {
+class ServiceImplementationOHOSNativeBuffer final : public ServiceImplementation {
+  public:
+    explicit ServiceImplementationOHOSNativeBuffer(Device* device) : ServiceImplementation(device) {
+        mGetProperties = reinterpret_cast<PFN_vkGetNativeBufferPropertiesOHOS>(
+            device->fn.GetDeviceProcAddr(device->GetVkDevice(), "vkGetNativeBufferPropertiesOHOS"));
+        // HarmonyOS shipping SDKs use 0x2000; newer Khronos headers registered
+        // 0x8000. Probe rather than imposing a header's ABI on an older driver.
+        for (auto value : {0x2000u, 0x8000u}) {
+            mHandleType = static_cast<VkExternalMemoryHandleTypeFlagBits>(value);
+            if (SupportsImportMemory(
+                    VK_FORMAT_R8G8B8A8_UNORM, VK_IMAGE_TYPE_2D, VK_IMAGE_TILING_OPTIMAL,
+                    VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT |
+                        VK_IMAGE_USAGE_TRANSFER_DST_BIT,
+                    VK_IMAGE_CREATE_ALIAS_BIT)) {
+                break;
+            }
+            mHandleType = static_cast<VkExternalMemoryHandleTypeFlagBits>(0);
+        }
+    }
+    bool SupportsImportMemory(VkFormat format,
+                              VkImageType type,
+                              VkImageTiling tiling,
+                              VkImageUsageFlags usage,
+                              VkImageCreateFlags flags) override {
+        if (!mGetProperties || !mHandleType) {
+            return false;
+        }
+        VkPhysicalDeviceExternalImageFormatInfo ext = {};
+        ext.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_EXTERNAL_IMAGE_FORMAT_INFO;
+        ext.handleType = mHandleType;
+        VkPhysicalDeviceImageFormatInfo2 info = {};
+        info.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_IMAGE_FORMAT_INFO_2;
+        info.pNext = &ext;
+        info.format = format;
+        info.type = type;
+        info.tiling = tiling;
+        info.usage = usage;
+        info.flags = flags;
+        VkExternalImageFormatProperties external = {};
+        external.sType = VK_STRUCTURE_TYPE_EXTERNAL_IMAGE_FORMAT_PROPERTIES;
+        VkImageFormatProperties2 properties = {};
+        properties.sType = VK_STRUCTURE_TYPE_IMAGE_FORMAT_PROPERTIES_2;
+        properties.pNext = &external;
+        auto result = mDevice->fn.GetPhysicalDeviceImageFormatProperties2(
+            ToBackend(mDevice->GetPhysicalDevice())->GetVkPhysicalDevice(), &info, &properties);
+        return result == VK_SUCCESS && (external.externalMemoryProperties.externalMemoryFeatures &
+                                        VK_EXTERNAL_MEMORY_FEATURE_IMPORTABLE_BIT);
+    }
+    bool SupportsCreateImage(const ExternalImageDescriptor*,
+                             VkFormat format,
+                             VkImageUsageFlags usage,
+                             bool* disjoint) override {
+        *disjoint = false;
+        return SupportsImportMemory(format, VK_IMAGE_TYPE_2D, VK_IMAGE_TILING_OPTIMAL, usage,
+                                    VK_IMAGE_CREATE_ALIAS_BIT);
+    }
+    ResultOrError<MemoryImportParams> GetMemoryImportParams(
+        const ExternalImageDescriptor* descriptor,
+        VkImage image) override {
+        DAWN_INVALID_IF(descriptor->GetType() != ExternalImageType::OHOSNativeBuffer,
+                        "Expected an OHOS NativeBuffer descriptor.");
+        auto* native = static_cast<const ExternalImageDescriptorOHOSNativeBuffer*>(descriptor);
+        DAWN_INVALID_IF(!native->handle || !mGetProperties,
+                        "Missing NativeBuffer import handle or function.");
+        VkNativeBufferFormatPropertiesOHOS format = {};
+        format.sType = VK_STRUCTURE_TYPE_NATIVE_BUFFER_FORMAT_PROPERTIES_OHOS;
+        VkNativeBufferPropertiesOHOS props = {};
+        props.sType = VK_STRUCTURE_TYPE_NATIVE_BUFFER_PROPERTIES_OHOS;
+        props.pNext = &format;
+        DAWN_TRY(
+            CheckVkSuccess(mGetProperties(mDevice->GetVkDevice(),
+                                          static_cast<OH_NativeBuffer*>(native->handle), &props),
+                           "vkGetNativeBufferPropertiesOHOS"));
+        VkMemoryRequirements requirements;
+        mDevice->fn.GetImageMemoryRequirements(mDevice->GetVkDevice(), image, &requirements);
+        uint32_t types = props.memoryTypeBits & requirements.memoryTypeBits;
+        DAWN_INVALID_IF(!types || requirements.size > props.allocationSize,
+                        "NativeBuffer allocation incompatible with Vulkan image requirements.");
+        const auto* texture = FromAPI(descriptor->cTextureDescriptor);
+        DAWN_INVALID_IF(format.format != VulkanImageFormat(mDevice, texture->format),
+                        "NativeBuffer format does not match imported texture format.");
+        MemoryImportParams params;
+        params.allocationSize = props.allocationSize;
+        params.memoryTypeIndex = static_cast<uint32_t>(__builtin_ctz(types));
+        params.dedicatedAllocation = true;
+        params.nativeBuffer = native->handle;
+        return params;
+    }
+    uint32_t GetQueueFamilyIndex() override { return VK_QUEUE_FAMILY_FOREIGN_EXT; }
+    ResultOrError<VkDeviceMemory> ImportMemory(ExternalMemoryHandle,
+                                               const MemoryImportParams& params,
+                                               VkImage image) override {
+        VkImportNativeBufferInfoOHOS native = {};
+        native.sType = VK_STRUCTURE_TYPE_IMPORT_NATIVE_BUFFER_INFO_OHOS;
+        native.buffer = static_cast<OH_NativeBuffer*>(params.nativeBuffer);
+        VkMemoryDedicatedAllocateInfo dedicated = {};
+        dedicated.sType = VK_STRUCTURE_TYPE_MEMORY_DEDICATED_ALLOCATE_INFO;
+        dedicated.image = image;
+        dedicated.pNext = &native;
+        VkMemoryAllocateInfo info = {};
+        info.sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO;
+        info.pNext = &dedicated;
+        info.allocationSize = params.allocationSize;
+        info.memoryTypeIndex = params.memoryTypeIndex;
+        VkDeviceMemory memory = VK_NULL_HANDLE;
+        DAWN_TRY(CheckVkSuccess(
+            mDevice->fn.AllocateMemory(mDevice->GetVkDevice(), &info, nullptr, &*memory),
+            "vkAllocateMemory(NativeBuffer)"));
+        return memory;
+    }
+    ResultOrUnknownError<VkImage> CreateImage(const ExternalImageDescriptor*,
+                                              const VkImageCreateInfo& base) override {
+        VkExternalMemoryImageCreateInfo external = {};
+        external.sType = VK_STRUCTURE_TYPE_EXTERNAL_MEMORY_IMAGE_CREATE_INFO;
+        external.handleTypes = mHandleType;
+        VkImageCreateInfo info = base;
+        external.pNext = info.pNext;
+        info.pNext = &external;
+        info.flags |= VK_IMAGE_CREATE_ALIAS_BIT;
+        info.tiling = VK_IMAGE_TILING_OPTIMAL;
+        info.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+        VkImage image;
+        DAWN_TRY(
+            CheckVkSuccess(mDevice->fn.CreateImage(mDevice->GetVkDevice(), &info, nullptr, &*image),
+                           "vkCreateImage(NativeBuffer)"));
+        return image;
+    }
+    bool Supported() const override { return mHandleType != 0 && mGetProperties; }
+
+  private:
+    PFN_vkGetNativeBufferPropertiesOHOS mGetProperties = nullptr;
+    VkExternalMemoryHandleTypeFlagBits mHandleType =
+        static_cast<VkExternalMemoryHandleTypeFlagBits>(0);
+};
+std::unique_ptr<ServiceImplementation> CreateOHOSNativeBufferService(Device* device) {
+    return std::make_unique<ServiceImplementationOHOSNativeBuffer>(device);
+}
+}  // namespace dawn::native::vulkan::external_memory
